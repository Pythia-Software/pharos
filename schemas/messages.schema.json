{
  "$schema": "https://github.com/Pythia-Software/query-table/schema/query-table.schema.json",
  "name": "pharos_messages",
  "version": 1,
  "idField": "id",
  "defaultLimit": 50,
  "defaultSort": [
    {
      "field": "sent_at",
      "dir": "desc",
      "nulls": "last"
    }
  ],
  "tiebreakSort": [
    {
      "field": "id",
      "dir": "asc"
    }
  ],
  "defaultSelect": [
    {
      "field": "sent_at",
      "width": 150
    },
    {
      "field": "role",
      "width": 100
    },
    {
      "field": "kind",
      "width": 120
    },
    {
      "field": "text",
      "width": 410
    },
    {
      "field": "model",
      "width": 160
    },
    {
      "field": "title",
      "width": 220
    }
  ],
  "fields": [
    {
      "name": "id",
      "label": "Message ID",
      "type": "text",
      "select": {
        "default": false
      },
      "bindings": {
        "postgres": {
          "expr": "id",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"id\""
        }
      }
    },
    {
      "name": "sent_at",
      "label": "Occurred",
      "type": "datetime",
      "group": "Time",
      "render": "datetime_rel",
      "bindings": {
        "postgres": {
          "expr": "sent_at",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"sent_at\"",
          "datetimeFormat": "utc-millis"
        }
      },
      "aggregate": {
        "groupable": true
      }
    },
    {
      "name": "day",
      "label": "Day",
      "type": "text",
      "group": "Time",
      "aliases": [
        "date"
      ],
      "select": {
        "default": false
      },
      "bindings": {
        "postgres": {
          "expr": "day",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"day\""
        }
      }
    },
    {
      "name": "week",
      "label": "Week (Mon)",
      "type": "text",
      "group": "Time",
      "select": {
        "default": false
      },
      "bindings": {
        "postgres": {
          "expr": "week",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"week\""
        }
      }
    },
    {
      "name": "month",
      "label": "Month",
      "type": "text",
      "group": "Time",
      "select": {
        "default": false
      },
      "bindings": {
        "postgres": {
          "expr": "month",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"month\""
        }
      }
    },
    {
      "name": "authorship_sent_at",
      "label": "Writing sent",
      "description": "Timestamp recorded for this message by Writing classification; can differ from the source message time.",
      "type": "datetime",
      "group": "Writing context",
      "select": {
        "default": false
      },
      "render": "datetime_rel",
      "bindings": {
        "postgres": {
          "expr": "authorship_sent_at",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"authorship_sent_at\"",
          "datetimeFormat": "utc-millis"
        }
      },
      "aggregate": {
        "groupable": true
      }
    },
    {
      "name": "authorship_day",
      "label": "Writing day",
      "description": "Calendar day recorded by Writing classification; can differ from the source message day.",
      "type": "text",
      "group": "Writing context",
      "select": {
        "default": false
      },
      "bindings": {
        "postgres": {
          "expr": "authorship_day",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"authorship_day\""
        }
      }
    },
    {
      "name": "authorship_week",
      "label": "Writing week (Mon)",
      "description": "Monday-based week of the Writing classification day.",
      "type": "text",
      "group": "Writing context",
      "select": {
        "default": false
      },
      "bindings": {
        "postgres": {
          "expr": "authorship_week",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"authorship_week\""
        }
      }
    },
    {
      "name": "authorship_month",
      "label": "Writing month",
      "description": "Month of the Writing classification day.",
      "type": "text",
      "group": "Writing context",
      "select": {
        "default": false
      },
      "bindings": {
        "postgres": {
          "expr": "authorship_month",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"authorship_month\""
        }
      }
    },
    {
      "name": "text",
      "label": "Message",
      "type": "text",
      "group": "Message",
      "render": "authored_text",
      "filter": {
        "values": {
          "source": "freeform"
        }
      },
      "aliases": [
        "content",
        "prompt"
      ],
      "bindings": {
        "postgres": {
          "expr": "text",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"text\""
        }
      },
      "aggregate": {
        "groupable": false,
        "measure": false
      }
    },
    {
      "name": "main_category",
      "label": "Mostly",
      "type": "enum",
      "group": "Message",
      "render": "authorship_category",
      "aliases": [
        "category"
      ],
      "filter": {
        "editor": "set",
        "values": {
          "source": "static",
          "options": [
            {
              "value": "typed",
              "label": "Typed"
            },
            {
              "value": "pasted",
              "label": "Likely pasted"
            },
            {
              "value": "quoted",
              "label": "Copied"
            },
            {
              "value": "resent",
              "label": "Re-sent"
            },
            {
              "value": "template",
              "label": "Template"
            },
            {
              "value": "attachment",
              "label": "Attachment"
            },
            {
              "value": "harness",
              "label": "App instructions"
            },
            {
              "value": "automated",
              "label": "Automated"
            }
          ]
        }
      },
      "bindings": {
        "postgres": {
          "expr": "main_category",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"main_category\""
        }
      }
    },
    {
      "name": "categories",
      "label": "Categories",
      "type": "textarray",
      "group": "Message",
      "render": "authorship_categories",
      "select": {
        "default": false
      },
      "filter": {
        "editor": "set",
        "values": {
          "source": "static",
          "options": [
            {
              "value": "typed",
              "label": "Typed"
            },
            {
              "value": "pasted",
              "label": "Likely pasted"
            },
            {
              "value": "quoted",
              "label": "Copied"
            },
            {
              "value": "resent",
              "label": "Re-sent"
            },
            {
              "value": "template",
              "label": "Template"
            },
            {
              "value": "attachment",
              "label": "Attachment"
            },
            {
              "value": "harness",
              "label": "App instructions"
            },
            {
              "value": "automated",
              "label": "Automated"
            }
          ]
        }
      },
      "bindings": {
        "postgres": {
          "expr": "categories",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"categories\""
        }
      }
    },
    {
      "name": "rules",
      "label": "Rules",
      "type": "textarray",
      "group": "Message",
      "render": "authorship_rules",
      "aliases": [
        "reason",
        "why"
      ],
      "select": {
        "default": false
      },
      "filter": {
        "editor": "set",
        "values": {
          "source": "static",
          "options": [
            "No other rule matched",
            "Code block",
            "Log, trace, code, or data",
            "Table",
            "Formatted like agent output",
            "Mostly identifiers, paths, or code",
            "Path, URL, or ID",
            "Sent faster than typing",
            "Generated page feedback",
            "Human feedback comment",
            "Quoted with >",
            "Matches recent agent output",
            "Already sent earlier",
            "Line already sent in other conversations",
            "Repeated prompt",
            "Slash command",
            "Attachment reference",
            "Conductor system instruction",
            "System reminder",
            "Environment context",
            "Project instructions",
            "Plugin recommendations",
            "Harness context",
            "Launched by a command",
            "Sent by a headless claude -p run",
            "Sent by a codex exec run",
            "Sent by a headless agy -p run",
            "Sent by automation",
            "Sent by another agent session",
            "Sent by TL1 orchestration",
            "Sub-agent conversation",
            "Sent by a headless claude -p or SDK run Conductor did not start",
            "Matches agent-written content",
            "Generated question form",
            "Pasted conversation",
            "Reported output"
          ]
        }
      },
      "bindings": {
        "postgres": {
          "expr": "rules",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"rules\""
        }
      }
    },
    {
      "name": "has_source",
      "label": "Copied from a conversation",
      "type": "bool",
      "group": "Message",
      "select": {
        "default": false
      },
      "bindings": {
        "postgres": {
          "expr": "has_source",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"has_source\""
        }
      }
    },
    {
      "name": "typed_message",
      "label": "Has typed text",
      "type": "bool",
      "group": "Message",
      "select": {
        "default": false
      },
      "bindings": {
        "postgres": {
          "expr": "typed_message",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"typed_message\""
        }
      }
    },
    {
      "name": "correction_cue",
      "label": "Authored correction cue",
      "description": "English correction substrings inside individual typed/dictated spans only, including I meant, you misunderstood, and you missed. Negation and hypothetical wording can match; not a mistake classification.",
      "type": "bool",
      "group": "Steering",
      "select": {
        "default": false
      },
      "bindings": {
        "postgres": {
          "expr": "correction_cue",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"correction_cue\""
        }
      }
    },
    {
      "name": "positive_cue",
      "label": "Authored positive cue",
      "description": "English praise/thanks substrings inside individual typed/dictated spans only, including great work, looks good, and thank you. Negation and politeness can match; not measured satisfaction or completion.",
      "type": "bool",
      "group": "Steering",
      "select": {
        "default": false
      },
      "bindings": {
        "postgres": {
          "expr": "positive_cue",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"positive_cue\""
        }
      }
    },
    {
      "name": "typed_words",
      "label": "Typed words",
      "type": "number",
      "group": "Your writing",
      "render": "number",
      "select": {
        "align": "right"
      },
      "bindings": {
        "postgres": {
          "expr": "typed_words",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"typed_words\"",
          "expressionNumeric": true
        }
      },
      "aggregate": {
        "groupable": true
      }
    },
    {
      "name": "typed_share",
      "label": "Typed %",
      "type": "number",
      "group": "Your writing",
      "render": "number",
      "select": {
        "default": false,
        "align": "right"
      },
      "aggregate": {
        "measure": false,
        "groupable": true
      },
      "bindings": {
        "postgres": {
          "expr": "typed_share",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"typed_share\"",
          "expressionNumeric": true
        }
      }
    },
    {
      "name": "other_words",
