{
  "$schema": "https://github.com/Pythia-Software/query-table/schema/query-table.schema.json",
  "name": "pharos_branch_usage",
  "version": 1,
  "idField": "id",
  "defaultLimit": 50,
  "defaultSort": [
    {
      "field": "usage_at",
      "dir": "desc",
      "nulls": "last"
    }
  ],
  "tiebreakSort": [
    {
      "field": "id",
      "dir": "asc"
    }
  ],
  "defaultSelect": [
    {
      "field": "usage_at",
      "width": 130
    },
    {
      "field": "title",
      "width": 260
    },
    {
      "field": "project_name",
      "width": 150
    },
    {
      "field": "branch",
      "width": 200
    },
    {
      "field": "coverage",
      "width": 140
    },
    {
      "field": "model_family",
      "width": 140
    },
    {
      "field": "cost_usd",
      "width": 100
    },
    {
      "field": "tokens",
      "width": 100
    }
  ],
  "fields": [
    {"name": "id", "label": "ID", "type": "text", "select": {"default": false}, "bindings": {"postgres": {"expr": "id", "synthetic": true}, "sqlite": {"expr": "r.\"id\""}}},
    {"name": "workspace_id", "label": "Session", "type": "text", "select": {"default": false}, "bindings": {"postgres": {"expr": "workspace_id", "synthetic": true}, "sqlite": {"expr": "r.\"workspace_id\""}}, "aggregate": {"groupable": true}},
    {"name": "title", "label": "Work", "type": "text", "group": "Work", "render": "work_title", "bindings": {"postgres": {"expr": "title", "synthetic": true}, "sqlite": {"expr": "r.\"title\""}}},
    {"name": "usage_at", "label": "Usage", "type": "datetime", "group": "Time", "render": "datetime_rel", "description": "The hour of this row's usage (UTC). A row is one session's usage on one branch, with one model, in one hour.", "bindings": {"postgres": {"expr": "usage_at", "synthetic": true}, "sqlite": {"expr": "r.\"usage_at\"", "datetimeFormat": "rfc3339"}}, "aggregate": {"groupable": true}},
    {"name": "day", "label": "Day", "type": "text", "group": "Time", "select": {"default": false}, "description": "The local day of the usage.", "bindings": {"postgres": {"expr": "day", "synthetic": true}, "sqlite": {"expr": "r.\"day\""}}, "aggregate": {"groupable": true}},
    {"name": "project_name", "label": "Project", "type": "text", "group": "Context", "render": "project", "description": "The repository, else the working folder (home as ~); empty for a session with no working directory (No project).", "bindings": {"postgres": {"expr": "project_name", "synthetic": true}, "sqlite": {"expr": "r.\"project_name\""}}, "aggregate": {"groupable": true}},
    {"name": "branch", "label": "Branch", "type": "text", "group": "Branch", "render": "branch_usage", "description": "The branch the usage was on; empty when its coverage is Unknown branch or No branch data.", "bindings": {"postgres": {"expr": "branch", "synthetic": true}, "sqlite": {"expr": "r.\"branch\""}}, "aggregate": {"groupable": true}},
    {"name": "project_branch", "label": "Project and branch", "type": "text", "group": "Branch", "select": {"default": false}, "description": "The project and the branch, as one value: a branch name used in several projects is a separate branch in each. Empty when the coverage is Unknown branch or No branch data.", "bindings": {"postgres": {"expr": "project_branch", "synthetic": true}, "sqlite": {"expr": "r.\"project_branch\""}}, "aggregate": {"groupable": true}},
    {"name": "coverage", "label": "Coverage", "type": "enum", "group": "Branch", "render": "option_label", "description": "On a branch: the transcript recorded the branch for these turns, or the source recorded one for the whole session. Unknown branch: a session that recorded a branch, but before its first, on a detached HEAD, or usage its transcript did not place on a turn. No branch data: a session that recorded no branch.", "filter": {"editor": "set", "values": {"source": "static", "options": [{"value": "on_branch", "label": "On a branch"}, {"value": "unknown", "label": "Unknown branch"}, {"value": "no_branch_data", "label": "No branch data"}]}}, "bindings": {"postgres": {"expr": "coverage", "synthetic": true}, "sqlite": {"expr": "r.\"coverage\""}}, "aggregate": {"groupable": true}},
    {"name": "branch_source", "label": "Branch recorded", "type": "enum", "group": "Branch", "render": "option_label", "select": {"default": false}, "description": "Turn: from the branch recorded on each turn (Claude Code). Session: one branch the source recorded for the whole session (Codex). Empty without a branch.", "filter": {"editor": "set", "values": {"source": "static", "options": [{"value": "turn", "label": "Per turn"}, {"value": "session", "label": "Per session"}]}}, "bindings": {"postgres": {"expr": "branch_source", "synthetic": true}, "sqlite": {"expr": "r.\"branch_source\""}}, "aggregate": {"groupable": true}},
    {"name": "source_kind", "label": "Source", "type": "enum", "group": "Context", "filter": {"editor": "set", "values": {"source": "static", "options": [{"value": "tl1", "label": "TL1"}, {"value": "tl1-export", "label": "TL1 export"}, {"value": "conductor", "label": "Conductor"}, {"value": "codex", "label": "Codex"}, {"value": "claude", "label": "Claude"}, {"value": "chatgpt", "label": "ChatGPT"}, {"value": "antigravity", "label": "Antigravity"}, {"value": "canonical", "label": "Canonical"}]}}, "bindings": {"postgres": {"expr": "source_kind", "synthetic": true}, "sqlite": {"expr": "r.\"source_kind\""}}, "aggregate": {"groupable": true}},
    {"name": "channel", "label": "Channel", "type": "text", "group": "Origin", "select": {"default": false}, "render": "origin_channel", "description": "How the top-level conversation started; linked helpers inherit this channel. Preserved across duplicate history sources. See Channel attribution for direct, inherited, inferred or unknown attribution.", "bindings": {"postgres": {"expr": "channel", "synthetic": true}, "sqlite": {"expr": "r.\"channel\""}}, "aggregate": {"groupable": true}},
    {"name": "channel_status", "label": "Channel attribution", "type": "text", "group": "Origin", "select": {"default": false}, "description": "How the initiating channel was established, including direct, inherited, inferred, unverified, unknown and unresolved attribution.", "bindings": {"postgres": {"expr": "channel_status", "synthetic": true}, "sqlite": {"expr": "r.\"channel_status\""}}, "aggregate": {"groupable": true}},
    {"name": "provider", "label": "Provider", "type": "text", "group": "Context", "select": {"default": false}, "bindings": {"postgres": {"expr": "provider", "synthetic": true}, "sqlite": {"expr": "r.\"provider\""}}, "aggregate": {"groupable": true}},
    {"name": "model", "label": "Model", "type": "text", "group": "Context", "select": {"default": false}, "description": "The model as the usage records it.", "bindings": {"postgres": {"expr": "model", "synthetic": true}, "sqlite": {"expr": "r.\"model\""}}, "aggregate": {"groupable": true}},
    {"name": "model_family", "label": "Model family", "type": "text", "group": "Context", "bindings": {"postgres": {"expr": "model_family", "synthetic": true}, "sqlite": {"expr": "r.\"model_family\""}}, "aggregate": {"groupable": true}},
    {"name": "cost_usd", "label": "Cost (API $)", "type": "number", "group": "Cost", "render": "usd", "description": "The usage's API-equivalent cost, priced as the Library prices it. A session's usage within an hour is split among its branches by the tokens each branch's turns used.", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "cost_usd", "synthetic": true}, "sqlite": {"expr": "r.\"cost_usd\"", "expressionNumeric": true}}, "aggregate": {"groupable": true}},
    {"name": "tokens", "label": "Tokens", "type": "number", "group": "Cost", "render": "number", "description": "Reconciled tokens, split among branches the same way.", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "tokens", "synthetic": true}, "sqlite": {"expr": "r.\"tokens\"", "expressionNumeric": true}}, "aggregate": {"groupable": true}},
    {"name": "price_status", "label": "Price status", "type": "enum", "group": "Cost", "select": {"default": false}, "filter": {"editor": "set", "values": {"source": "static", "options": ["priced", "assumed", "partial", "unpriced"]}}, "bindings": {"postgres": {"expr": "price_status", "synthetic": true}, "sqlite": {"expr": "r.\"price_status\""}}}
  ]
}
