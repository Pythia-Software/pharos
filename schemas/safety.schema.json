{
  "$schema": "https://github.com/Pythia-Software/query-table/schema/query-table.schema.json",
  "name": "pharos_safety",
  "version": 1,
  "idField": "id",
  "defaultLimit": 50,
  "defaultSort": [
    {
      "field": "danger",
      "dir": "desc"
    },
    {
      "field": "last_seen_at",
      "dir": "desc"
    }
  ],
  "tiebreakSort": [
    {
      "field": "id",
      "dir": "asc"
    }
  ],
  "defaultSelect": [
    {
      "field": "state",
      "width": 110
    },
    {
      "field": "danger",
      "width": 90
    },
    {
      "field": "title",
      "width": 300
    },
    {
      "field": "subject",
      "width": 250
    },
    {
      "field": "target_label",
      "width": 140
    },
    {
      "field": "calls",
      "width": 100
    },
    {
      "field": "last_seen_at",
      "width": 130
    }
  ],
  "fields": [
    {
      "name": "id",
      "label": "Notice ID",
      "type": "text",
      "group": "Notice",
      "bindings": {
        "postgres": {
          "expr": "id",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"id\""
        }
      },
      "select": {
        "default": false
      }
    },
    {
      "name": "title",
      "label": "Notice",
      "type": "text",
      "group": "Notice",
      "bindings": {
        "postgres": {
          "expr": "title",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"title\""
        }
      },
      "render": "truncate"
    },
    {
      "name": "state",
      "label": "State",
      "type": "enum",
      "group": "Notice",
      "bindings": {
        "postgres": {
          "expr": "state",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"state\""
        }
      },
      "filter": {
        "editor": "set",
        "values": {
          "source": "static",
          "options": [
            {
              "value": "open",
              "label": "Open"
            },
            {
              "value": "handed_off",
              "label": "Handed off"
            },
            {
              "value": "dismissed",
              "label": "Closed"
            }
          ]
        }
      },
      "render": "safety_state"
    },
    {
      "name": "rule_label",
      "label": "Check",
      "type": "text",
      "group": "Notice",
      "bindings": {
        "postgres": {
          "expr": "rule_label",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"rule_label\""
        }
      },
      "filter": {
        "values": {
          "source": "distinct"
        }
      }
    },
    {
      "name": "rule",
      "label": "Check type",
      "type": "enum",
      "group": "Notice",
      "bindings": {
        "postgres": {
          "expr": "rule",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"rule\""
        }
      },
      "select": {
        "default": false
      },
      "filter": {
        "editor": "set",
        "values": {
          "source": "static",
          "options": [
            {
              "value": "api",
              "label": "Remote service changed by an API request"
            },
            {
              "value": "boundary-delete",
              "label": "Deletion outside the checkout"
            },
            {
              "value": "cloud-delete",
              "label": "Cloud objects deleted"
            },
            {
              "value": "credentials",
              "label": "Credentials copied to another location"
            },
            {
              "value": "database",
              "label": "Database changed outside the checkout"
            },
            {
              "value": "delete",
              "label": "Checkout or ignored files deleted"
            },
            {
              "value": "disk-image",
              "label": "Disk image or volume detached or changed"
            },
            {
              "value": "local-history",
              "label": "Shared Git work discarded"
            },
            {
              "value": "permissions",
              "label": "Permissions broadened"
            },
            {
              "value": "process",
              "label": "Every instance of a program stopped"
            },
            {
              "value": "publication",
              "label": "Published release deleted or replaced"
            },
            {
              "value": "remote-history",
              "label": "Published Git history rewritten"
            },
            {
              "value": "safeguard-gate",
              "label": "Agent bypassed a product rule, gate or policy"
            },
            {
              "value": "safeguard-other",
              "label": "Agent got around an instruction another way"
            },
            {
              "value": "safeguard-restriction",
              "label": "Agent got around a harness or tool restriction"
            },
            {
              "value": "safeguard-test",
              "label": "Agent weakened, skipped or removed a test or check"
            },
            {
              "value": "system",
              "label": "System or disk changed"
            }
          ]
        }
      }
    },
    {
      "name": "danger",
      "label": "Danger",
      "type": "enum",
      "group": "Notice",
      "bindings": {
        "postgres": {
          "expr": "danger",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"danger\""
        }
      },
      "filter": {
        "editor": "set",
        "values": {
          "source": "static",
          "options": [
            {
              "value": "high",
              "label": "Dangerous"
            },
            {
              "value": "medium",
              "label": "Risky"
            },
            {
              "value": "low",
              "label": "Low"
            }
          ]
        }
      },
      "sort": {
        "field": "danger_rank"
      },
      "description": "How likely a notice of this check is to need you. Dangerous: credentials, published history, cloud and disk changes. Risky: deletions, databases, permissions, releases.",
      "render": "option_label"
    },
    {
      "name": "danger_rank",
      "label": "Danger rank",
      "type": "number",
      "group": "Notice",
      "bindings": {
        "postgres": {
          "expr": "danger_rank",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"danger_rank\"",
          "expressionNumeric": true
        }
      },
      "description": "3 high, 2 medium, 1 low; sorting by Danger uses it.",
      "select": {
        "enabled": false
      },
      "filter": {
        "enabled": false
      }
    },
    {
      "name": "subject",
      "label": "Selected resource",
      "type": "text",
      "group": "Notice",
      "bindings": {
        "postgres": {
          "expr": "subject",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"subject\""
        }
      },
      "render": "truncate"
    },
    {
      "name": "target",
      "label": "Location ID",
      "type": "text",
      "group": "Notice",
      "bindings": {
        "postgres": {
          "expr": "target",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"target\""
        }
      },
      "select": {
        "default": false
      }
    },
    {
      "name": "target_label",
      "label": "Location",
      "type": "text",
      "group": "Notice",
      "bindings": {
        "postgres": {
          "expr": "target_label",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"target_label\""
        }
      },
      "filter": {
        "values": {
          "source": "distinct"
        }
      }
    },
    {
      "name": "command",
      "label": "Latest command",
      "type": "text",
      "group": "Notice",
      "bindings": {
        "postgres": {
          "expr": "command",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"command\""
        }
      },
      "select": {
        "default": false
      },
      "render": "truncate"
    },
    {
      "name": "cwd",
      "label": "Working directory",
      "type": "text",
      "group": "Notice",
      "bindings": {
        "postgres": {
          "expr": "cwd",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"cwd\""
        }
      },
      "select": {
        "default": false
      },
      "render": "truncate"
    },
    {
      "name": "calls",
      "label": "Calls in discovery window",
      "type": "number",
      "group": "Activity",
      "bindings": {
        "postgres": {
          "expr": "calls",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"calls\"",
          "expressionNumeric": true
        }
      },
      "render": "number",
      "aggregate": {
        "groupable": true
      }
    },
    {
      "name": "material_change",
      "label": "New execution evidence",
      "type": "bool",
      "group": "Notice",
      "bindings": {
        "postgres": {
          "expr": "material_change",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"material_change\""
        }
      }
    },
    {
      "name": "in_prompt",
      "label": "In a prompt",
      "type": "bool",
      "group": "Notice",
      "bindings": {
        "postgres": {
          "expr": "in_prompt",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"in_prompt\""
        }
      }
    },
    {
      "name": "first_seen_at",
      "label": "First seen",
      "type": "datetime",
      "group": "Activity",
      "bindings": {
        "postgres": {
          "expr": "first_seen_at",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"first_seen_at\"",
          "datetimeFormat": "rfc3339"
        }
      },
      "render": "datetime_rel",
      "aggregate": {
        "groupable": true
      }
    },
    {
      "name": "last_seen_at",
      "label": "Last seen",
      "type": "datetime",
      "group": "Activity",
      "bindings": {
        "postgres": {
          "expr": "last_seen_at",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"last_seen_at\"",
          "datetimeFormat": "rfc3339"
        }
      },
      "render": "datetime_rel",
      "aggregate": {
        "groupable": true
      }
    },
    {
      "name": "handed_at",
      "label": "Handed off",
      "type": "datetime",
      "group": "Activity",
      "bindings": {
        "postgres": {
          "expr": "handed_at",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"handed_at\"",
          "datetimeFormat": "rfc3339"
        }
      },
      "render": "datetime_rel",
      "aggregate": {
        "groupable": true
      }
    },
    {
      "name": "review_count",
      "label": "Notices",
      "type": "number",
      "group": "Activity",
      "bindings": {
        "postgres": {
          "expr": "review_count",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"review_count\"",
          "expressionNumeric": true
        }
      },
      "render": "number",
      "aggregate": {
        "groupable": true
      },
      "select": {
        "default": false
      },
      "description": "One per notice. Sum to count notices when grouping."
    }
  ]
}
