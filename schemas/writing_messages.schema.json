{
  "$schema": "https://github.com/Pythia-Software/query-table/schema/query-table.schema.json",
  "name": "pharos_writing_messages",
  "version": 1,
  "idField": "id",
  "defaultLimit": 50,
  "defaultSort": [
    {
      "field": "sent_at",
      "dir": "desc",
      "nulls": "last"
    }
  ],
  "tiebreakSort": [
    {
      "field": "id",
      "dir": "asc"
    }
  ],
  "defaultSelect": [
    {
      "field": "sent_at",
      "width": 110
    },
    {
      "field": "text",
      "width": 480
    },
    {
      "field": "main_category",
      "width": 120
    },
    {
      "field": "typed_words",
      "width": 95
    },
    {
      "field": "other_words",
      "width": 110
    },
    {
      "field": "title",
      "width": 220
    },
    {
      "field": "repository_name",
      "width": 140
    }
  ],
  "fields": [
    {
      "name": "id",
      "label": "Message ID",
      "type": "text",
      "select": {
        "default": false
      },
      "bindings": {
        "postgres": {
          "expr": "id",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"id\""
        }
      }
    },
    {
      "name": "sent_at",
      "label": "Sent",
      "type": "datetime",
      "group": "Time",
      "render": "datetime_rel",
      "bindings": {
        "postgres": {
          "expr": "sent_at",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"sent_at\"",
          "datetimeFormat": "utc-millis"
        }
      },
      "aggregate": {
        "groupable": true
      }
    },
    {
      "name": "day",
      "label": "Day",
      "type": "text",
      "group": "Time",
      "aliases": [
        "date"
      ],
      "select": {
        "default": false
      },
      "bindings": {
        "postgres": {
          "expr": "day",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"day\""
        }
      }
    },
    {
      "name": "week",
      "label": "Week (Mon)",
      "type": "text",
      "group": "Time",
      "select": {
        "default": false
      },
      "bindings": {
        "postgres": {
          "expr": "week",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"week\""
        }
      }
    },
    {
      "name": "month",
      "label": "Month",
      "type": "text",
      "group": "Time",
      "select": {
        "default": false
      },
      "bindings": {
        "postgres": {
          "expr": "month",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"month\""
        }
      }
    },
    {
      "name": "text",
      "label": "Message",
      "type": "text",
      "group": "Message",
      "render": "authored_text",
      "aliases": [
        "content",
        "prompt"
      ],
      "bindings": {
        "postgres": {
          "expr": "text",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"text\""
        }
      }
    },
    {
      "name": "main_category",
      "label": "Mostly",
      "type": "enum",
      "group": "Message",
      "render": "authorship_category",
      "aliases": [
        "kind",
        "category"
      ],
      "filter": {
        "values": {
          "source": "static",
          "options": [
            {
              "value": "typed",
              "label": "Typed"
            },
            {
              "value": "pasted",
              "label": "Likely pasted"
            },
            {
              "value": "quoted",
              "label": "Copied"
            },
            {
              "value": "resent",
              "label": "Re-sent"
            },
            {
              "value": "template",
              "label": "Template"
            },
            {
              "value": "attachment",
              "label": "Attachment"
            },
            {
              "value": "harness",
              "label": "Harness"
            },
            {
              "value": "automated",
              "label": "Automated"
            }
          ]
        }
      },
      "bindings": {
        "postgres": {
          "expr": "main_category",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"main_category\""
        }
      }
    },
    {
      "name": "categories",
      "label": "Categories",
      "type": "textarray",
      "group": "Message",
      "render": "authorship_categories",
      "select": {
        "default": false
      },
      "filter": {
        "editor": "set",
        "values": {
          "source": "static",
          "options": [
            {
              "value": "typed",
              "label": "Typed"
            },
            {
              "value": "pasted",
              "label": "Likely pasted"
            },
            {
              "value": "quoted",
              "label": "Copied"
            },
            {
              "value": "resent",
              "label": "Re-sent"
            },
            {
              "value": "template",
              "label": "Template"
            },
            {
              "value": "attachment",
              "label": "Attachment"
            },
            {
              "value": "harness",
              "label": "Harness"
            },
            {
              "value": "automated",
              "label": "Automated"
            }
          ]
        }
      },
      "bindings": {
        "postgres": {
          "expr": "categories",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"categories\""
        }
      }
    },
    {
      "name": "rules",
      "label": "Rules",
      "type": "textarray",
      "group": "Message",
      "render": "authorship_rules",
      "aliases": [
        "reason",
        "why"
      ],
      "select": {
        "default": false
      },
      "filter": {
        "editor": "set",
        "values": {
          "source": "static",
          "options": [
            "No other rule matched",
            "Code block",
            "Log, trace, code, or data",
            "Table",
            "Formatted like agent output",
            "Mostly identifiers, paths, or code",
            "Path, URL, or ID",
            "Sent faster than typing",
            "Generated page feedback",
            "Quoted with >",
            "Matches recent agent output",
            "Already sent earlier",
            "Line already sent in other conversations",
            "Repeated prompt",
            "Slash command",
            "Attachment reference",
            "Conductor system instruction",
            "System reminder",
            "Environment context",
            "Project instructions",
            "Plugin recommendations",
            "Harness context",
            "Launched by a command",
            "Sent by a headless claude -p run",
            "Sent by a codex exec run",
            "Sent by a headless agy -p run",
            "Sent by automation",
            "Sent by another agent session",
            "Sent by TL1 orchestration",
            "Sub-agent conversation",
            "Sent by a headless claude -p or SDK run Conductor did not start"
          ]
        }
      },
      "bindings": {
        "postgres": {
          "expr": "rules",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"rules\""
        }
      }
    },
