      "name": "occurred_at",
      "label": "Compacted at",
      "type": "datetime",
      "group": "Compaction",
      "bindings": {
        "postgres": {
          "expr": "occurred_at",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"occurred_at\"",
          "datetimeFormat": "rfc3339"
        }
      },
      "render": "datetime_rel",
      "aggregate": {
        "groupable": true
      }
    },
    {
      "name": "trigger",
      "label": "Trigger",
