{
  "name": "pharos_compactions",
  "version": 1,
  "idField": "id",
  "defaultLimit": 50,
  "defaultSort": [
    {
      "field": "occurred_at",
      "dir": "desc"
    }
  ],
  "tiebreakSort": [
    {
      "field": "id",
      "dir": "desc"
    }
  ],
  "defaultSelect": [
    {
      "field": "occurred_at"
    },
    {
      "field": "trigger"
    },
    {
      "field": "trigger_evidence"
    },
    {
      "field": "provider"
    },
    {
      "field": "harness"
    },
    {
      "field": "model"
    },
    {
      "field": "repository_name"
    }
  ],
  "fields": [
    {
      "name": "id",
      "label": "Id",
      "type": "text",
      "group": "Evidence",
      "bindings": {
        "postgres": {
          "expr": "id",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"id\""
        }
      },
      "aggregate": {
        "groupable": true
      }
    },
    {
      "name": "message_id",
      "label": "Message id",
      "type": "text",
      "group": "Evidence",
      "bindings": {
        "postgres": {
          "expr": "message_id",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"message_id\""
        }
      },
      "aggregate": {
        "groupable": true
      }
    },
    {
      "name": "conversation_id",
      "label": "Conversation id",
      "type": "text",
      "group": "Evidence",
      "bindings": {
        "postgres": {
          "expr": "conversation_id",
          "synthetic": true
