{
  "$schema": "https://github.com/Pythia-Software/query-table/schema/query-table.schema.json",
  "name": "pharos_mcp_calls",
  "version": 1,
  "idField": "id",
  "defaultLimit": 50,
  "defaultSort": [{ "field": "called_at", "dir": "desc" }],
  "tiebreakSort": [{ "field": "id", "dir": "desc" }],
  "defaultSelect": [
    { "field": "called_at", "width": 165 },
    { "field": "tool_name", "width": 230 },
    { "field": "status", "width": 95 },
    { "field": "estimated_output_tokens", "width": 115 },
    { "field": "duration_ms", "width": 95 },
    { "field": "result_count", "width": 85 },
    { "field": "truncated", "width": 85 }
  ],
  "fields": [
    { "name": "id", "label": "Call ID", "type": "number", "group": "Call", "render": "number", "select": {"default": false, "align": "right"}, "aggregate": {"measure": false, "groupable": true}, "bindings": {"postgres": {"expr": "id", "synthetic": true}, "sqlite": {"expr": "r.\"id\"", "expressionNumeric": true}} },
    { "name": "called_at", "label": "Called at", "type": "datetime", "group": "Time", "render": "datetime_rel", "bindings": {"postgres": {"expr": "called_at", "synthetic": true}, "sqlite": {"expr": "r.\"called_at\"", "datetimeFormat": "rfc3339"}}, "aggregate": {"groupable": true} },
    { "name": "day", "label": "Day", "type": "text", "group": "Time", "select": {"default": false}, "bindings": {"postgres": {"expr": "day", "synthetic": true}, "sqlite": {"expr": "r.\"day\""}} },
    { "name": "week", "label": "Week (Mon)", "type": "text", "group": "Time", "select": {"default": false}, "bindings": {"postgres": {"expr": "week", "synthetic": true}, "sqlite": {"expr": "r.\"week\""}} },
    { "name": "month", "label": "Month", "type": "text", "group": "Time", "select": {"default": false}, "bindings": {"postgres": {"expr": "month", "synthetic": true}, "sqlite": {"expr": "r.\"month\""}} },
    { "name": "tool_name", "label": "Tool", "type": "text", "group": "Call", "filter": {"values": {"source": "distinct"}}, "bindings": {"postgres": {"expr": "tool_name", "synthetic": true}, "sqlite": {"expr": "r.\"tool_name\""}} },
    { "name": "status", "label": "Status", "type": "enum", "group": "Call", "render": "mcp_status", "filter": {"values": {"source": "static", "options": ["ok", "error", "disabled", "oversized"]}}, "bindings": {"postgres": {"expr": "status", "synthetic": true}, "sqlite": {"expr": "r.\"status\""}} },
    { "name": "arguments_json", "label": "Arguments (sanitized)", "type": "text", "group": "Evidence", "render": "truncate", "bindings": {"postgres": {"expr": "arguments_json", "synthetic": true}, "sqlite": {"expr": "r.\"arguments_json\""}} },
    { "name": "error_text", "label": "Error", "type": "text", "group": "Evidence", "render": "truncate", "bindings": {"postgres": {"expr": "error_text", "synthetic": true}, "sqlite": {"expr": "r.\"error_text\""}} },
    { "name": "duration_ms", "label": "Duration (ms)", "type": "number", "group": "Performance", "render": "number", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "duration_ms", "synthetic": true}, "sqlite": {"expr": "r.\"duration_ms\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "response_bytes", "label": "Response bytes", "type": "number", "group": "Output", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "response_bytes", "synthetic": true}, "sqlite": {"expr": "r.\"response_bytes\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "estimated_output_tokens", "label": "Est. output tokens", "type": "number", "group": "Output", "render": "number", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "estimated_output_tokens", "synthetic": true}, "sqlite": {"expr": "r.\"estimated_output_tokens\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "result_count", "label": "Results", "type": "number", "group": "Output", "render": "number", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "result_count", "synthetic": true}, "sqlite": {"expr": "r.\"result_count\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "truncated", "label": "Truncated", "type": "bool", "group": "Output", "bindings": {"postgres": {"expr": "truncated", "synthetic": true}, "sqlite": {"expr": "r.\"truncated\""}} },
    { "name": "call_count", "label": "Calls", "type": "number", "group": "Metrics", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "call_count", "synthetic": true}, "sqlite": {"expr": "r.\"call_count\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "error_count", "label": "Errors", "type": "number", "group": "Metrics", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "error_count", "synthetic": true}, "sqlite": {"expr": "r.\"error_count\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "truncated_count", "label": "Truncated calls", "type": "number", "group": "Metrics", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "truncated_count", "synthetic": true}, "sqlite": {"expr": "r.\"truncated_count\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} }
  ]
}
