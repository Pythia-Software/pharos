        }
      },
      "bindings": {
        "postgres": {
          "expr": "effort",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"effort\""
        }
      },
      "description": "Recorded agent effort level; unavailable when the source does not report it.",
      "select": {
        "default": true
      }
    },
    {
