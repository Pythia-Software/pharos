{
  "$schema": "https://github.com/Pythia-Software/query-table/schema/query-table.schema.json",
  "name": "pharos_conversation_activity",
  "version": 1,
  "idField": "id",
  "defaultLimit": 50,
  "defaultSort": [
    {
      "field": "event_at",
      "dir": "desc"
    }
  ],
  "tiebreakSort": [
    {
      "field": "id",
      "dir": "asc"
    }
  ],
  "defaultSelect": [
    {
      "field": "event_at",
      "width": 155
    },
    {
      "field": "title",
      "width": 235
    },
    {
      "field": "event_kind",
      "width": 100
    },
    {
      "field": "root_model_family",
      "width": 145
    },
    {
      "field": "human_input_tokens_estimate",
      "width": 125
    },
    {
      "field": "output_tokens",
      "width": 115
    }
  ],
  "fields": [
    {
      "name": "id",
      "label": "Event ID",
      "type": "text",
      "bindings": {
        "postgres": {
          "expr": "id",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"id\""
        }
      },
      "aggregate": {
        "groupable": true
      }
    },
    {
      "name": "event_at",
      "label": "Recorded at",
      "type": "datetime",
      "bindings": {
        "postgres": {
          "expr": "event_at",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"event_at\"",
          "datetimeFormat": "rfc3339"
        }
      },
      "aggregate": {
        "groupable": true
      },
      "render": "datetime_rel"
    },
    {
      "name": "event_kind",
      "label": "Event kind",
      "type": "text",
      "bindings": {
        "postgres": {
          "expr": "event_kind",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"event_kind\""
        }
      },
      "aggregate": {
        "groupable": true
      },
      "display": {
        "kind": "chip",
        "labels": {
          "human": "Human input",
          "usage": "Agent output"
        }
      }
    },
    {
      "name": "root_conversation_id",
      "label": "Top-level conversation",
      "type": "text",
      "render": "conversation_link",
      "bindings": {
        "postgres": {
          "expr": "root_conversation_id",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"root_conversation_id\""
        }
      },
      "aggregate": {
        "groupable": true
      },
      "relationship": {
        "objectType": "pharos_conversations",
        "key": {
          "id": "root_conversation_id"
        }
      }
    },
    {
      "name": "root_provider",
      "label": "Top-level provider",
      "type": "text",
      "bindings": {
        "postgres": {
          "expr": "root_provider",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"root_provider\""
        }
      },
      "aggregate": {
        "groupable": true
      }
    },
    {
      "name": "root_model_family",
      "label": "Top-level model",
      "type": "text",
      "bindings": {
        "postgres": {
          "expr": "root_model_family",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"root_model_family\""
        }
      },
      "aggregate": {
        "groupable": true
      }
    },
    {
      "name": "root_effort",
      "label": "Top-level effort",
      "type": "text",
      "bindings": {
        "postgres": {
          "expr": "root_effort",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"root_effort\""
        }
      },
      "aggregate": {
        "groupable": true
      }
    },
    {
      "name": "human_input_tokens_estimate",
      "label": "Est. human text tokens",
      "type": "number",
      "bindings": {
        "postgres": {
          "expr": "human_input_tokens_estimate",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"human_input_tokens_estimate\"",
          "expressionNumeric": true
        }
      },
      "aggregate": {
        "groupable": true
      },
      "render": "number",
      "description": "Ceiling of retained UTF-8 human-supplied text bytes / 4 per classified message, excluding harness and automated spans; includes pasted/quoted text and attachment references, but no image or unretained file bytes. An estimate, not model tokenization."
    },
    {
      "name": "human_messages",
      "label": "Human messages",
      "type": "number",
      "bindings": {
        "postgres": {
          "expr": "human_messages",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"human_messages\"",
          "expressionNumeric": true
        }
      },
      "aggregate": {
        "groupable": true
      },
      "render": "number"
    },
    {
      "name": "output_tokens",
      "label": "Recorded output tokens",
      "type": "number",
      "bindings": {
        "postgres": {
          "expr": "output_tokens",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"output_tokens\"",
          "expressionNumeric": true
        }
      },
      "aggregate": {
        "groupable": true
      },
      "render": "number"
    },
    {
      "name": "workspace_id",
      "label": "Workspace",
      "type": "text",
      "bindings": {
        "postgres": {
          "expr": "workspace_id",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"workspace_id\""
        }
      },
      "aggregate": {
        "groupable": true
      }
    },
    {
      "name": "title",
      "label": "Conversation",
      "type": "text",
      "group": "Context",
      "select": {
        "default": false
      },
      "bindings": {
        "postgres": {
          "expr": "title",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"title\""
        }
      },
      "render": "usage_conversation"
    },
    {
      "name": "repository_name",
      "label": "Repository",
      "type": "text",
      "group": "Context",
      "select": {
        "default": false
      },
      "bindings": {
        "postgres": {
          "expr": "repository_name",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"repository_name\""
        }
      }
    },
    {
      "name": "conversation_id",
      "label": "Source conversation",
      "type": "text",
      "group": "Evidence",
      "select": {
        "default": false
      },
      "bindings": {
        "postgres": {
          "expr": "conversation_id",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"conversation_id\""
        }
      }
    },
    {
      "name": "message_id",
      "label": "Source message",
      "type": "text",
      "group": "Evidence",
      "select": {
        "default": false
      },
      "bindings": {
        "postgres": {
          "expr": "message_id",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"message_id\""
        }
      }
    },
    {
      "name": "root_title",
      "label": "Root conversation",
      "type": "text",
      "group": "Attribution",
      "select": {
        "default": false
      },
      "bindings": {
        "postgres": {
          "expr": "root_title",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"root_title\""
        }
      }
    }
  ]
}
