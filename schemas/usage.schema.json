{
  "$schema": "https://github.com/Pythia-Software/query-table/schema/query-table.schema.json",
  "name": "pharos_usage",
  "version": 1,
  "idField": "id",
  "defaultLimit": 50,
  "defaultSort": [{ "field": "day", "dir": "desc", "nulls": "last" }, { "field": "total_tokens", "dir": "desc" }],
  "tiebreakSort": [{ "field": "id", "dir": "asc" }],
  "defaultSelect": [
    {"field": "day", "width": 105},
    {"field": "title", "width": 235},
    {"field": "repository_name", "width": 130},
    {"field": "model_effort", "width": 175},
    {"field": "total_tokens", "width": 110},
    {"field": "cost_usd", "width": 95},
    {"field": "output_tokens", "width": 110},
    {"field": "cache_read_share", "width": 95}
  ],
  "fields": [
    { "name": "id", "label": "Row ID", "type": "text", "select": {"default": false}, "bindings": {"postgres": {"expr": "id", "synthetic": true}, "sqlite": {"expr": "r.\"id\""}} },
    { "name": "day", "label": "Day", "type": "text", "group": "Time", "aliases": ["date"], "bindings": {"postgres": {"expr": "day", "synthetic": true}, "sqlite": {"expr": "r.\"day\""}} },
    { "name": "hour", "label": "Hour", "type": "text", "group": "Time", "select": {"default": false}, "bindings": {"postgres": {"expr": "hour", "synthetic": true}, "sqlite": {"expr": "r.\"hour\""}} },
    { "name": "week", "label": "Week (Mon)", "type": "text", "group": "Time", "bindings": {"postgres": {"expr": "week", "synthetic": true}, "sqlite": {"expr": "r.\"week\""}} },
    { "name": "month", "label": "Month", "type": "text", "group": "Time", "bindings": {"postgres": {"expr": "month", "synthetic": true}, "sqlite": {"expr": "r.\"month\""}} },
    { "name": "first_usage_at", "label": "First usage", "type": "datetime", "group": "Time", "render": "datetime_rel", "select": {"default": false}, "bindings": {"postgres": {"expr": "first_usage_at", "synthetic": true}, "sqlite": {"expr": "r.\"first_usage_at\"", "datetimeFormat": "rfc3339"}}, "aggregate": {"groupable": true} },
    { "name": "last_usage_at", "label": "Last usage", "type": "datetime", "group": "Time", "render": "datetime_rel", "select": {"default": false}, "bindings": {"postgres": {"expr": "last_usage_at", "synthetic": true}, "sqlite": {"expr": "r.\"last_usage_at\"", "datetimeFormat": "rfc3339"}}, "aggregate": {"groupable": true} },
    { "name": "repository_name", "label": "Repository", "type": "text", "group": "Context", "aliases": ["repo"], "bindings": {"postgres": {"expr": "r.display_name"}, "sqlite": {"expr": "r.\"repository_name\""}} },
    { "name": "provider", "label": "Provider", "type": "enum", "group": "Model", "aliases": ["service"], "filter": {"editor": "set", "values": {"source": "static", "options": [{"value": "claude", "label": "Claude"}, {"value": "codex", "label": "Codex"}, {"value": "tl1", "label": "TL1"}, {"value": "chatgpt", "label": "ChatGPT"}, {"value": "antigravity", "label": "Antigravity"}, {"value": "canonical", "label": "Canonical"}]}}, "bindings": {"postgres": {"expr": "a.provider"}, "sqlite": {"expr": "r.\"provider\""}} },
    {"name": "channel", "label": "Channel", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "channel", "synthetic": true}, "sqlite": {"expr": "r.\"channel\""}}, "description": "Initiating channel, inherited through the entire task tree.", "render": "origin_channel"},
    {"name": "machine_id", "label": "Machine", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "machine_id", "synthetic": true}, "sqlite": {"expr": "r.\"machine_id\""}}, "description": "Initiating location, inherited through the task tree; execution location is separate.", "render": "origin_machine_id"},
    {"name": "machine", "label": "Machine name", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "machine", "synthetic": true}, "sqlite": {"expr": "r.\"machine\""}}, "description": "Recorded task origin metadata."},
    {"name": "machine_kind", "label": "Machine kind", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "machine_kind", "synthetic": true}, "sqlite": {"expr": "r.\"machine_kind\""}}, "description": "Recorded task origin metadata."},
    {"name": "execution_machine_id", "label": "Execution machine", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "execution_machine_id", "synthetic": true}, "sqlite": {"expr": "r.\"execution_machine_id\""}}, "description": "Recorded task origin metadata.", "render": "origin_execution_machine_id"},
    {"name": "execution_machine", "label": "Execution machine name", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "execution_machine", "synthetic": true}, "sqlite": {"expr": "r.\"execution_machine\""}}, "description": "Recorded task origin metadata."},
    {"name": "execution_machine_kind", "label": "Execution machine kind", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "execution_machine_kind", "synthetic": true}, "sqlite": {"expr": "r.\"execution_machine_kind\""}}, "description": "Recorded task origin metadata."},
    {"name": "channel_status", "label": "Channel attribution", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "channel_status", "synthetic": true}, "sqlite": {"expr": "r.\"channel_status\""}}, "description": "Recorded task origin metadata."},
    {"name": "machine_status", "label": "Machine attribution", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "machine_status", "synthetic": true}, "sqlite": {"expr": "r.\"machine_status\""}}, "description": "Recorded task origin metadata."},
    {"name": "execution_machine_status", "label": "Execution machine attribution", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "execution_machine_status", "synthetic": true}, "sqlite": {"expr": "r.\"execution_machine_status\""}}, "description": "Recorded task origin metadata."},
    {"name": "origin_conversation_id", "label": "Initiating conversation", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "origin_conversation_id", "synthetic": true}, "sqlite": {"expr": "r.\"origin_conversation_id\""}}, "description": "Recorded task origin metadata."},
    {"name": "origin_evidence", "label": "Origin evidence", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "origin_evidence", "synthetic": true}, "sqlite": {"expr": "r.\"origin_evidence\""}}, "description": "Recorded task origin metadata."},
    {"name": "channels", "label": "Channels", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "channels", "synthetic": true}, "sqlite": {"expr": "r.\"channels\""}}, "description": "Recorded task origin metadata."},
    {"name": "machines", "label": "Machines", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "machines", "synthetic": true}, "sqlite": {"expr": "r.\"machines\""}}, "description": "Recorded task origin metadata."},
    {"name": "execution_machines", "label": "Execution machines", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "execution_machines", "synthetic": true}, "sqlite": {"expr": "r.\"execution_machines\""}}, "description": "Recorded task origin metadata."},
    { "name": "model_family", "label": "Model", "type": "text", "group": "Model", "bindings": {"postgres": {"expr": "model_family", "synthetic": true}, "sqlite": {"expr": "r.\"model_family\""}} },
    {"name": "model_effort", "label": "Model + effort", "type": "text", "group": "Model", "select": {"default": false}, "filter": {"values": {"source": "distinct"}}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "model_effort", "synthetic": true}, "sqlite": {"expr": "r.\"model_effort\""}}, "description": "Recorded model and effort pairs; missing effort is labeled Unknown effort."},
    { "name": "model", "label": "Reported model", "type": "text", "group": "Model", "select": {"default": false}, "bindings": {"postgres": {"expr": "model", "synthetic": true}, "sqlite": {"expr": "r.\"model\""}} },
    {"name": "effort", "label": "Effort", "type": "text", "group": "Model", "select": {"default": true}, "bindings": {"postgres": {"expr": "effort", "synthetic": true}, "sqlite": {"expr": "r.\"effort\""}}, "description": "Recorded agent effort level; unavailable when the source does not report it."},
    { "name": "source_kind", "label": "Source", "type": "enum", "group": "Context", "filter": {"editor": "set", "values": {"source": "static", "options": [{"value": "tl1", "label": "TL1"}, {"value": "tl1-export", "label": "TL1 export"}, {"value": "conductor", "label": "Conductor"}, {"value": "codex", "label": "Codex"}, {"value": "claude", "label": "Claude"}, {"value": "chatgpt", "label": "ChatGPT"}, {"value": "antigravity", "label": "Antigravity"}, {"value": "canonical", "label": "Canonical"}]}}, "bindings": {"postgres": {"expr": "w.source_kind"}, "sqlite": {"expr": "r.\"source_kind\""}} },
    { "name": "harness", "label": "Harness", "type": "text", "group": "Context", "bindings": {"postgres": {"expr": "harness", "synthetic": true}, "sqlite": {"expr": "r.\"harness\""}} },
    { "name": "harness_version_first", "label": "Harness version first", "type": "text", "group": "Context", "select": {"default": false}, "bindings": {"postgres": {"expr": "harness_version_first", "synthetic": true}, "sqlite": {"expr": "r.\"harness_version_first\""}} },
    { "name": "harness_version_last", "label": "Harness version last", "type": "text", "group": "Context", "select": {"default": false}, "bindings": {"postgres": {"expr": "harness_version_last", "synthetic": true}, "sqlite": {"expr": "r.\"harness_version_last\""}} },
    { "name": "harness_version_source", "label": "Harness version source", "type": "text", "group": "Context", "select": {"default": false}, "bindings": {"postgres": {"expr": "harness_version_source", "synthetic": true}, "sqlite": {"expr": "r.\"harness_version_source\""}} },
    { "name": "session_kind", "label": "Agent", "type": "enum", "group": "Context", "filter": {"editor": "set", "values": {"source": "static", "options": ["root", "subagent"]}}, "bindings": {"postgres": {"expr": "a.kind"}, "sqlite": {"expr": "r.\"session_kind\""}} },
    { "name": "session_role", "label": "Session role", "type": "enum", "group": "Context", "select": {"default": false}, "filter": {"editor": "set", "values": {"source": "static", "options": [{"value": "singleton", "label": "Singleton"}, {"value": "parent", "label": "Parent"}, {"value": "subagent", "label": "Subagent"}]}}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "session_role", "synthetic": true}, "sqlite": {"expr": "r.\"session_role\""}}, "description": "Recorded subagents retain their role. Recorded roots split into parent (known delegated children) or singleton (no known children), across full recorded execution lineage including tokenless children, continuations, and linked launches. Unresolved root lineage is unavailable; child activity need not fall inside the usage window." },
    {"name": "run_role", "label": "Run role", "type": "enum", "group": "Conversation", "select": {"default": false}, "filter": {"editor": "set", "values": {"source": "static", "options": [{"value": "standalone", "label": "Standalone"}, {"value": "parent", "label": "Parent"}, {"value": "delegated", "label": "Delegated"}]}}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "run_role", "synthetic": true}, "sqlite": {"expr": "r.\"run_role\""}}, "description": "Canonical execution role from resolved lineage: delegated for all non-root executions (including linked launches), parent for root executions with known children, standalone otherwise. Continuations keep their execution role. Child presence uses full recorded lineage, including tokenless children. Missing/cyclic execution lineage is unavailable."},
    { "name": "depth", "label": "Agent depth", "type": "number", "group": "Context", "render": "number", "select": {"default": false, "align": "right"}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "a.depth"}, "sqlite": {"expr": "r.\"depth\"", "expressionNumeric": true}} },
    {"name": "title", "label": "Conversation", "type": "text", "group": "Context", "render": "usage_conversation", "bindings": {"postgres": {"expr": "w.title"}, "sqlite": {"expr": "r.\"title\""}}},
    { "name": "total_tokens", "label": "Total tokens", "type": "number", "group": "Tokens", "render": "number", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "u.total_tokens"}, "sqlite": {"expr": "r.\"total_tokens\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "input_tokens", "label": "Input (all)", "type": "number", "group": "Tokens", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "u.input_tokens"}, "sqlite": {"expr": "r.\"input_tokens\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "uncached_input_tokens", "label": "Uncached input", "type": "number", "group": "Tokens", "render": "number", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "u.uncached_input_tokens"}, "sqlite": {"expr": "r.\"uncached_input_tokens\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "cache_read_input_tokens", "label": "Cached input (reads)", "type": "number", "group": "Tokens", "render": "number", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "u.cache_read_input_tokens"}, "sqlite": {"expr": "r.\"cache_read_input_tokens\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "cache_creation_input_tokens", "label": "Cache writes", "type": "number", "group": "Tokens", "render": "number", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "u.cache_creation_input_tokens"}, "sqlite": {"expr": "r.\"cache_creation_input_tokens\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "cache_creation_5m_input_tokens", "label": "Cache writes (5m)", "type": "number", "group": "Tokens", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "u.cache_creation_5m_input_tokens"}, "sqlite": {"expr": "r.\"cache_creation_5m_input_tokens\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "cache_creation_1h_input_tokens", "label": "Cache writes (1h)", "type": "number", "group": "Tokens", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "u.cache_creation_1h_input_tokens"}, "sqlite": {"expr": "r.\"cache_creation_1h_input_tokens\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "output_tokens", "label": "Output", "type": "number", "group": "Tokens", "render": "number", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "u.output_tokens"}, "sqlite": {"expr": "r.\"output_tokens\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "reasoning_output_tokens", "label": "Reasoning output", "type": "number", "group": "Tokens", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "u.reasoning_output_tokens"}, "sqlite": {"expr": "r.\"reasoning_output_tokens\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "unclassified_tokens", "label": "Unclassified", "type": "number", "group": "Tokens", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "u.unclassified_tokens"}, "sqlite": {"expr": "r.\"unclassified_tokens\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "cost_usd", "label": "Cost (API $)", "type": "number", "group": "Cost", "render": "usd", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "cost_usd", "synthetic": true}, "sqlite": {"expr": "r.\"cost_usd\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "cost_today_usd", "label": "Cost at today's prices", "type": "number", "group": "Cost", "render": "usd", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "cost_today_usd", "synthetic": true}, "sqlite": {"expr": "r.\"cost_today_usd\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "price_status", "label": "Price status", "type": "enum", "group": "Cost", "select": {"default": false}, "filter": {"editor": "set", "values": {"source": "static", "options": ["priced", "assumed", "partial", "unpriced"]}}, "bindings": {"postgres": {"expr": "price_status", "synthetic": true}, "sqlite": {"expr": "r.\"price_status\""}} },
    { "name": "priced_model", "label": "Priced as", "type": "text", "group": "Cost", "select": {"default": false}, "bindings": {"postgres": {"expr": "priced_model", "synthetic": true}, "sqlite": {"expr": "r.\"priced_model\""}} },
    { "name": "carbon_tier", "label": "Carbon tier", "type": "enum", "group": "Carbon", "select": {"default": false}, "filter": {"editor": "set", "values": {"source": "static", "options": [{"value": "small", "label": "Small"}, {"value": "medium", "label": "Mid-size"}, {"value": "large", "label": "Large"}]}}, "bindings": {"postgres": {"expr": "carbon_tier", "synthetic": true}, "sqlite": {"expr": "r.\"carbon_tier\""}}, "description": "Model size tier the Carbon Impact estimate assigns from the model name; unrecognized models take the mid-size tier." },
    { "name": "energy_wh", "label": "Energy (Wh)", "type": "number", "group": "Carbon", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "energy_wh", "synthetic": true}, "sqlite": {"expr": "r.\"energy_wh\"", "expressionNumeric": true}}, "aggregate": {"groupable": true}, "description": "Modeled estimate of inference energy, including data-center overhead (PUE), using the Carbon Impact settings. Not a measurement." },
    { "name": "co2e_g", "label": "CO₂e (g)", "type": "number", "group": "Carbon", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "co2e_g", "synthetic": true}, "sqlite": {"expr": "r.\"co2e_g\"", "expressionNumeric": true}}, "aggregate": {"groupable": true}, "description": "Modeled estimate of grams of CO₂-equivalent emissions for this usage, using the Carbon Impact settings (estimate, PUE, grid, and input sensitivity). Not a measurement." },
    { "name": "energy_kwh", "label": "Energy (kWh)", "type": "number", "group": "Carbon", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "energy_kwh", "synthetic": true}, "sqlite": {"expr": "r.\"energy_kwh\"", "expressionNumeric": true}}, "aggregate": {"groupable": true}, "description": "Energy (Wh) in kilowatt-hours: a modeled estimate including data-center overhead (PUE), using the Carbon Impact settings. Not a measurement." },
    { "name": "co2e_kg", "label": "CO₂e (kg)", "type": "number", "group": "Carbon", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "co2e_kg", "synthetic": true}, "sqlite": {"expr": "r.\"co2e_kg\"", "expressionNumeric": true}}, "aggregate": {"groupable": true}, "description": "CO₂e (g) in kilograms: a modeled estimate of CO₂-equivalent emissions using the Carbon Impact settings. Not a measurement." },
    { "name": "cache_read_share", "label": "Cache-read share %", "type": "number", "group": "Tokens", "render": "number", "select": {"default": false, "align": "right"}, "aggregate": {"measure": false, "groupable": true}, "bindings": {"postgres": {"expr": "cache_read_share", "synthetic": true}, "sqlite": {"expr": "r.\"cache_read_share\"", "expressionNumeric": true}} },
    { "name": "attribution", "label": "Time placement", "type": "enum", "group": "Evidence", "select": {"default": false}, "filter": {"editor": "set", "values": {"source": "static", "options": [{"value": "request", "label": "Request time"}, {"value": "session-start", "label": "Session start"}]}}, "bindings": {"postgres": {"expr": "u.attribution"}, "sqlite": {"expr": "r.\"attribution\""}} },
    { "name": "workspace_id", "relationship": {"objectType": "pharos_library", "key": {"id": "workspace_id"}}, "label": "Workspace ID", "type": "text", "group": "Evidence", "select": {"default": false}, "bindings": {"postgres": {"expr": "w.id"}, "sqlite": {"expr": "r.\"workspace_id\""}} },
    { "name": "conversation_id", "relationship": {"objectType": "pharos_conversations", "key": {"id": "conversation_id"}}, "label": "Conversation ID", "type": "text", "render": "conversation_link", "group": "Evidence", "select": {"default": false}, "bindings": {"postgres": {"expr": "a.conversation_id"}, "sqlite": {"expr": "r.\"conversation_id\""}} },
    {"name": "root_conversation_id", "label": "Top-level conversation ID", "type": "text", "render": "conversation_link", "group": "Conversation", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "root_conversation_id", "synthetic": true}, "sqlite": {"expr": "r.\"root_conversation_id\""}}, "description": "Recorded top-level conversation including nested agents, linked launches, and continuations. Unresolved parent chains are unavailable.", "relationship": {"objectType": "pharos_conversations", "key": {"id": "root_conversation_id"}}},
    {"name": "root_title", "label": "Top-level task title", "type": "text", "group": "Conversation", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "root_title", "synthetic": true}, "sqlite": {"expr": "r.\"root_title\""}}, "description": "Title of the retained workspace owning the top-level conversation, including for usage recorded by its delegated children."},
    {"name": "root_repository_name", "label": "Top-level repository", "type": "text", "group": "Conversation", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "root_repository_name", "synthetic": true}, "sqlite": {"expr": "r.\"root_repository_name\""}}, "description": "Repository of the retained top-level conversation; delegated usage is attributed to this repository for root-task comparisons."},
    {"name": "root_provider", "label": "Top-level provider", "type": "text", "group": "Conversation", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "root_provider", "synthetic": true}, "sqlite": {"expr": "r.\"root_provider\""}}, "description": "Provider recorded on the top-level conversation; delegated usage keeps this cohort even when it uses another provider."},
    {"name": "root_model_family", "label": "Top-level model", "type": "text", "group": "Conversation", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "root_model_family", "synthetic": true}, "sqlite": {"expr": "r.\"root_model_family\""}}, "description": "Model recorded on the top-level conversation; all delegated model costs and tokens belong to this one cohort."},
    {"name": "root_effort", "label": "Top-level effort", "type": "text", "group": "Conversation", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "root_effort", "synthetic": true}, "sqlite": {"expr": "r.\"root_effort\""}}, "description": "Effort recorded on the top-level conversation, not the effort used by each delegated run."},
    {"name": "delegated_session_id", "label": "Delegated run ID", "type": "text", "group": "Conversation", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "delegated_session_id", "synthetic": true}, "sqlite": {"expr": "r.\"delegated_session_id\""}}, "description": "Canonical delegated execution identity. Embedded subagents and linked child/command-launched conversations are counted once; root runs and continuations of a root are null. Count distinct within each top-level conversation for active delegated runs."},
    {"name": "delegated_run_depth", "label": "Delegation depth", "type": "number", "group": "Conversation", "render": "number", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "delegated_run_depth", "synthetic": true}, "sqlite": {"expr": "r.\"delegated_run_depth\"", "expressionNumeric": true}}, "description": "Resolved delegation levels below the top-level conversation. Root is zero; exact handles and continuations share their execution depth. Available only for resolved lineage."},
    { "name": "agent_session_id", "label": "Agent session ID", "type": "text", "group": "Evidence", "select": {"default": false}, "bindings": {"postgres": {"expr": "a.id"}, "sqlite": {"expr": "r.\"agent_session_id\""}} }
  ]
}
