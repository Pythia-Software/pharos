{
  "$schema": "https://github.com/Pythia-Software/query-table/schema/query-table.schema.json",
  "name": "pharos_library",
  "version": 2,
  "idField": "id",
  "defaultLimit": 50,
  "defaultSort": [{ "field": "activity_at", "dir": "desc", "nulls": "last" }],
  "tiebreakSort": [{ "field": "id", "dir": "asc" }],
  "defaultSelect": [
    { "field": "activity_at", "width": 130 },
    { "field": "title", "width": 300 },
    { "field": "project_name", "width": 150 },
    { "field": "models", "width": 200 },
    { "field": "efforts", "width": 120 },
    { "field": "token_count", "width": 100 },
    { "field": "cost_usd", "width": 100 },
    { "field": "subagent_count", "width": 90 },
    { "field": "pr_numbers", "width": 300 }
  ],
  "fields": [
    { "name": "id", "label": "ID", "type": "text", "select": {"default": false}, "bindings": {"postgres": {"expr": "w.id"}, "sqlite": {"expr": "r.\"id\""}} },
    { "name": "title", "label": "Workspace", "type": "text", "group": "Work", "render": "work_title", "bindings": {"postgres": {"expr": "w.title"}, "sqlite": {"expr": "r.\"title\""}} },
    { "name": "repository_name", "label": "Repository", "type": "text", "group": "Context", "description": "The Git repository, empty for a project that is a folder or none.", "aliases": ["repo"], "bindings": {"postgres": {"expr": "repository_name"}, "sqlite": {"expr": "r.\"repository_name\""}} },
    { "name": "project_name", "label": "Project", "type": "text", "group": "Context", "render": "project", "description": "The repository, else the working folder (home as ~); empty for a workspace with no working directory (No project).", "bindings": {"postgres": {"expr": "project_name"}, "sqlite": {"expr": "r.\"project_name\""}} },
    { "name": "project_kind", "label": "Project kind", "type": "enum", "group": "Context", "render": "option_label", "filter": {"editor": "set", "values": {"source": "static", "options": [{"value": "repository", "label": "Repository"}, {"value": "folder", "label": "Folder"}, {"value": "none", "label": "No project"}]}}, "bindings": {"postgres": {"expr": "project_kind"}, "sqlite": {"expr": "r.\"project_kind\""}} },
    { "name": "project_id", "label": "Project ID", "type": "text", "group": "Context", "select": {"default": false}, "bindings": {"postgres": {"expr": "project_id"}, "sqlite": {"expr": "r.\"project_id\""}} },
    { "name": "source_kind", "label": "Source", "type": "enum", "group": "Context", "filter": {"editor": "set", "values": {"source": "static", "options": [{"value": "tl1", "label": "TL1"}, {"value": "tl1-export", "label": "TL1 export"}, {"value": "conductor", "label": "Conductor"}, {"value": "codex", "label": "Codex"}, {"value": "claude", "label": "Claude"}, {"value": "chatgpt", "label": "ChatGPT"}, {"value": "antigravity", "label": "Antigravity"}, {"value": "canonical", "label": "Canonical export"}]}}, "bindings": {"postgres": {"expr": "w.source_kind"}, "sqlite": {"expr": "r.\"source_kind\""}} },
    { "name": "activity_at", "label": "Last activity", "type": "datetime", "group": "Time", "render": "datetime_rel", "bindings": {"postgres": {"expr": "w.activity_at"}, "sqlite": {"expr": "r.\"activity_at\"", "datetimeFormat": "rfc3339"}}, "aggregate": {"groupable": true} },
    { "name": "purpose", "label": "Purpose", "type": "text", "group": "Work", "render": "truncate", "bindings": {"postgres": {"expr": "w.purpose"}, "sqlite": {"expr": "r.\"purpose\""}} },
    { "name": "outcome", "label": "Outcome", "type": "text", "group": "Work", "render": "truncate", "bindings": {"postgres": {"expr": "w.outcome"}, "sqlite": {"expr": "r.\"outcome\""}} },
    { "name": "branch", "label": "Branch", "type": "text", "group": "Context", "render": "truncate", "bindings": {"postgres": {"expr": "w.branch"}, "sqlite": {"expr": "r.\"branch\""}} },
    { "name": "owner", "label": "Owner", "type": "text", "group": "Context", "bindings": {"postgres": {"expr": "w.owner"}, "sqlite": {"expr": "r.\"owner\""}} },
    { "name": "flavor", "label": "TL1 flavor", "type": "text", "group": "Context", "bindings": {"postgres": {"expr": "w.flavor"}, "sqlite": {"expr": "r.\"flavor\""}} },
    { "name": "version", "label": "Version", "type": "text", "group": "Context", "bindings": {"postgres": {"expr": "w.version"}, "sqlite": {"expr": "r.\"version\""}} },
    { "name": "lifecycle", "label": "Lifecycle", "type": "enum", "group": "Context", "bindings": {"postgres": {"expr": "w.lifecycle"}, "sqlite": {"expr": "r.\"lifecycle\""}} },
    { "name": "preservation_completeness", "label": "Preservation", "type": "enum", "group": "Archive", "bindings": {"postgres": {"expr": "w.preservation_completeness"}, "sqlite": {"expr": "r.\"preservation_completeness\""}} },
    { "name": "conversation_count", "label": "Conversations", "type": "number", "group": "Counts", "render": "number", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "conversation_count", "synthetic": true}, "sqlite": {"expr": "r.\"conversation_count\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "turn_count", "label": "Turns", "type": "number", "group": "Counts", "render": "number", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "turn_count", "synthetic": true}, "sqlite": {"expr": "r.\"turn_count\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "token_count", "label": "Tokens", "type": "number", "group": "Usage", "render": "number", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "token_count", "synthetic": true}, "sqlite": {"expr": "r.\"token_count\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "cost_usd", "label": "Cost (API $)", "type": "number", "group": "Cost", "render": "usd", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "cost_usd", "synthetic": true}, "sqlite": {"expr": "r.\"cost_usd\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "cost_today_usd", "label": "Cost at today's prices", "type": "number", "group": "Cost", "render": "usd", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "cost_today_usd", "synthetic": true}, "sqlite": {"expr": "r.\"cost_today_usd\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "price_status", "label": "Price status", "type": "enum", "group": "Cost", "select": {"default": false}, "filter": {"editor": "set", "values": {"source": "static", "options": ["priced", "assumed", "partial", "unpriced"]}}, "bindings": {"postgres": {"expr": "price_status", "synthetic": true}, "sqlite": {"expr": "r.\"price_status\""}} },
    { "name": "tool_use_count", "label": "Tool calls", "type": "number", "group": "Usage", "render": "number", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "tool_use_count", "synthetic": true}, "sqlite": {"expr": "r.\"tool_use_count\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "tool_error_count", "label": "Tool errors", "type": "number", "group": "Usage", "render": "number", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "tool_error_count", "synthetic": true}, "sqlite": {"expr": "r.\"tool_error_count\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "compaction_count", "label": "Compactions", "type": "number", "group": "Usage", "aliases": ["compactions", "compacts"], "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "compaction_count", "synthetic": true}, "sqlite": {"expr": "r.\"compaction_count\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "subagent_count", "label": "Sub-agents", "type": "number", "group": "Counts", "aliases": ["subagents"], "render": "number", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "subagent_count", "synthetic": true}, "sqlite": {"expr": "r.\"subagent_count\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "subagent_depth", "label": "Sub-agent depth", "type": "number", "group": "Counts", "aliases": ["agent_depth", "nesting"], "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "subagent_depth", "synthetic": true}, "sqlite": {"expr": "r.\"subagent_depth\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "pr_count", "label": "PRs", "type": "number", "group": "Counts", "render": "git_count", "description": "Linked pull requests; empty for a project that is not a repository.", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "pr_count", "synthetic": true}, "sqlite": {"expr": "r.\"pr_count\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "branch_count", "label": "Branches", "type": "number", "group": "Counts", "render": "git_count", "description": "Recorded branches; empty for a project that is not a repository.", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "branch_count", "synthetic": true}, "sqlite": {"expr": "r.\"branch_count\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "outcome_label", "label": "Outcome label", "type": "enum", "group": "Outcome", "render": "outcome_label", "description": "What became of the session's changes, decided by the evidence tier outcome_why names. Landed and Committed need local Git evidence.", "filter": {"editor": "set", "values": {"source": "static", "options": [{"value": "landed", "label": "Landed"}, {"value": "committed", "label": "Committed"}, {"value": "changed_kept", "label": "Changed and kept"}, {"value": "changed_recent", "label": "Changed, too recent"}, {"value": "reworked", "label": "Reworked"}, {"value": "no_changes", "label": "No changes"}, {"value": "unknown", "label": "Unknown"}]}}, "bindings": {"postgres": {"expr": "outcome_label", "synthetic": true}, "sqlite": {"expr": "r.\"outcome_label\""}} },
    { "name": "outcome_why", "label": "Outcome evidence", "type": "text", "group": "Outcome", "render": "truncate", "select": {"default": false}, "description": "The evidence that decided the outcome label, and its tier.", "bindings": {"postgres": {"expr": "outcome_why", "synthetic": true}, "sqlite": {"expr": "r.\"outcome_why\""}} },
    { "name": "files_changed", "label": "Files changed", "type": "number", "group": "Outcome", "render": "number", "description": "Files the session edited, from its own tool calls; temporary and agent-home files are left out.", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "files_changed", "synthetic": true}, "sqlite": {"expr": "r.\"files_changed\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "lines_added", "label": "Lines added", "type": "number", "group": "Outcome", "render": "number", "description": "Lines its edits added; empty when its harness records no line counts.", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "lines_added", "synthetic": true}, "sqlite": {"expr": "r.\"lines_added\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "lines_removed", "label": "Lines removed", "type": "number", "group": "Outcome", "render": "number", "description": "Lines its edits removed; empty when its harness records no line counts.", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "lines_removed", "synthetic": true}, "sqlite": {"expr": "r.\"lines_removed\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "verification", "label": "Verified after last edit", "type": "enum", "group": "Outcome", "render": "option_label", "select": {"default": false}, "description": "How the last test or build command after the session's last edit ended; empty for a session without edits.", "filter": {"editor": "set", "values": {"source": "static", "options": [{"value": "passed", "label": "Passed"}, {"value": "failed", "label": "Failed"}, {"value": "not_run", "label": "Not run"}, {"value": "unknown", "label": "No result"}]}}, "bindings": {"postgres": {"expr": "verification", "synthetic": true}, "sqlite": {"expr": "r.\"verification\""}} },
    { "name": "recorded_commits", "label": "Commits in transcript", "type": "number", "group": "Outcome", "render": "number", "description": "Commits whose git commit output the session's transcript holds (Tier 1); not checked against a repository.", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "recorded_commits", "synthetic": true}, "sqlite": {"expr": "r.\"recorded_commits\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "reworked_files", "label": "Reworked files", "type": "number", "group": "Outcome", "render": "number", "description": "Of its files, those in which a later session removed lines it added, within the rework window.", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "reworked_files", "synthetic": true}, "sqlite": {"expr": "r.\"reworked_files\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "file_edit_count", "label": "File edits", "type": "number", "group": "Counts", "render": "number", "select": {"align": "right"}, "bindings": {"postgres": {"expr": "file_edit_count", "synthetic": true}, "sqlite": {"expr": "r.\"file_edit_count\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "changed_file_count", "label": "Changed files", "type": "number", "group": "Counts", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "changed_file_count", "synthetic": true}, "sqlite": {"expr": "r.\"changed_file_count\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "pr_numbers", "label": "GitHub PRs", "type": "text", "group": "Links", "aliases": ["PR"], "render": "pull_requests", "bindings": {"postgres": {"expr": "pr_numbers", "synthetic": true}, "sqlite": {"expr": "r.\"pr_numbers\""}} },
    { "name": "main_merge_title", "label": "origin/main", "type": "text", "group": "Links", "render": "main_integration", "bindings": {"postgres": {"expr": "w.main_merge_title"}, "sqlite": {"expr": "r.\"main_merge_title\""}} },
    { "name": "providers", "label": "Providers", "type": "text", "group": "Context", "select": {"default": false}, "bindings": {"postgres": {"expr": "providers", "synthetic": true}, "sqlite": {"expr": "r.\"providers\""}} },
    {"name": "channel", "label": "Channel", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "channel", "synthetic": true}, "sqlite": {"expr": "r.\"channel\""}}, "description": "How the top-level conversation started; linked sub-agents inherit this channel.", "render": "origin_channel"},
    {"name": "machine_id", "label": "Machine", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "machine_id", "synthetic": true}, "sqlite": {"expr": "r.\"machine_id\""}}, "description": "Device where the top-level conversation started; linked sub-agents inherit this machine. Execution machine is recorded separately.", "render": "origin_machine_id"},
    {"name": "machine", "label": "Machine name", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "machine", "synthetic": true}, "sqlite": {"expr": "r.\"machine\""}}, "description": "Recorded channel or device details. Machine is where the top-level conversation started; Execution machine is where the agent session ran."},
    {"name": "machine_kind", "label": "Machine kind", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "machine_kind", "synthetic": true}, "sqlite": {"expr": "r.\"machine_kind\""}}, "description": "Recorded channel or device details. Machine is where the top-level conversation started; Execution machine is where the agent session ran."},
    {"name": "execution_machine_id", "label": "Execution machine", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "execution_machine_id", "synthetic": true}, "sqlite": {"expr": "r.\"execution_machine_id\""}}, "description": "Recorded channel or device details. Machine is where the top-level conversation started; Execution machine is where the agent session ran.", "render": "origin_execution_machine_id"},
    {"name": "execution_machine", "label": "Execution machine name", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "execution_machine", "synthetic": true}, "sqlite": {"expr": "r.\"execution_machine\""}}, "description": "Recorded channel or device details. Machine is where the top-level conversation started; Execution machine is where the agent session ran."},
    {"name": "execution_machine_kind", "label": "Execution machine kind", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "execution_machine_kind", "synthetic": true}, "sqlite": {"expr": "r.\"execution_machine_kind\""}}, "description": "Recorded channel or device details. Machine is where the top-level conversation started; Execution machine is where the agent session ran."},
    {"name": "channels", "label": "Channels", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "channels", "synthetic": true}, "sqlite": {"expr": "r.\"channels\""}}, "description": "Recorded channel or device details. Machine is where the top-level conversation started; Execution machine is where the agent session ran."},
    {"name": "machines", "label": "Machines", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "machines", "synthetic": true}, "sqlite": {"expr": "r.\"machines\""}}, "description": "Recorded channel or device details. Machine is where the top-level conversation started; Execution machine is where the agent session ran."},
    {"name": "execution_machines", "label": "Execution machines", "type": "text", "group": "Origin", "select": {"default": false}, "aggregate": {"groupable": true}, "bindings": {"postgres": {"expr": "execution_machines", "synthetic": true}, "sqlite": {"expr": "r.\"execution_machines\""}}, "description": "Recorded channel or device details. Machine is where the top-level conversation started; Execution machine is where the agent session ran."},
    { "name": "harnesses", "label": "Agent apps", "type": "text", "group": "Context", "select": {"default": false}, "bindings": {"postgres": {"expr": "harnesses", "synthetic": true}, "sqlite": {"expr": "r.\"harnesses\""}} },
    { "name": "harness_versions", "label": "Agent app versions", "type": "text", "group": "Context", "select": {"default": false}, "bindings": {"postgres": {"expr": "harness_versions", "synthetic": true}, "sqlite": {"expr": "r.\"harness_versions\""}} },
    { "name": "models", "label": "Models", "type": "text", "group": "Context", "bindings": {"postgres": {"expr": "models", "synthetic": true}, "sqlite": {"expr": "r.\"models\""}} },
    {
      "name": "model_efforts",
      "label": "Model + effort",
      "type": "text",
      "group": "Context",
      "select": {
        "default": false
      },
      "filter": {
        "values": {
          "source": "distinct"
        }
      },
      "aggregate": {
        "groupable": true
      },
      "bindings": {
        "postgres": {
          "expr": "model_efforts",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"model_efforts\""
        }
      },
      "description": "Recorded model and effort pairs; missing effort is labeled Unknown effort."
    },
    {
      "name": "efforts",
      "label": "Effort levels",
      "type": "text",
      "group": "Context",
      "bindings": {
        "postgres": {
          "expr": "efforts",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"efforts\""
        }
      },
      "description": "Recorded agent effort level; unavailable when the source does not report it.",
      "select": {
        "default": true
      }
    },
    { "name": "changed_files", "label": "Changed file path", "type": "text", "group": "Changes", "select": {"enabled": false}, "aliases": ["file", "path"], "bindings": {"postgres": {"expr": "changed_files", "synthetic": true}, "sqlite": {"expr": "r.\"changed_files\""}} },
    { "name": "error_types", "label": "Error type", "type": "text", "group": "Metrics", "select": {"enabled": false}, "bindings": {"postgres": {"expr": "error_types", "synthetic": true}, "sqlite": {"expr": "r.\"error_types\""}} },
    { "name": "location", "label": "Location", "type": "text", "group": "Archive", "render": "truncate", "bindings": {"postgres": {"expr": "w.location"}, "sqlite": {"expr": "r.\"location\""}} }
  ]
}
