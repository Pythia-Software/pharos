{
  "name": "pharos-query-tables",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --preserve-symlinks --minify --format=iife --target=safari17 --outfile=../internal/archive/assets/query-tables.js",
    "watch": "esbuild src/index.tsx --bundle --preserve-symlinks --minify --format=iife --target=safari17 --outfile=../internal/archive/assets/query-tables.js --watch=forever",
    "check-bundle": "esbuild src/index.tsx --bundle --preserve-symlinks --minify --format=iife --target=safari17 --log-level=warning --outfile=node_modules/.cache/check-bundle/query-tables.js && cmp node_modules/.cache/check-bundle/query-tables.js ../internal/archive/assets/query-tables.js && cmp node_modules/.cache/check-bundle/query-tables.css ../internal/archive/assets/query-tables.css && echo 'query-table bundle matches web/src'",
    "generate-schemas": "node generate-schemas.mjs",
    "check-schemas": "node generate-schemas.mjs --check",
    "test:usage-aggregations": "node --test tests/usage-aggregations.test.mjs",
    "test:computed-store": "node --test tests/computed-column-store.test.mjs",
    "test:previews": "node --test tests/query-previews.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:text-search": "node --test tests/text-search-model.test.mjs",
    "test:search-composer": "node --test tests/search-composer.test.mjs",
    "link:local": "node ../tools/link-query-table.mjs",
    "watch:local": "node ../tools/watch-query-table.mjs"
  },
  "dependencies": {
    "@pythia-software/query-table-core": "file:vendor/query-table-core-phoenix-01d37558a748.tgz",
    "@pythia-software/query-table-react": "file:vendor/query-table-react-phoenix-01d37558a748.tgz",
    "@pythia-software/query-table-ui": "file:vendor/query-table-ui-phoenix-01d37558a748.tgz",
    "@types/markdown-it": "14.1.2",
    "markdown-it": "15.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@pythia-software/query-table-codegen": "file:vendor/query-table-codegen-phoenix-01d37558a748.tgz",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.27.2",
    "typescript": "5.6.3"
  }
}
