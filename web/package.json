{
  "name": "pharos-query-tables",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --minify --format=iife --target=safari17 --outfile=../internal/archive/assets/query-tables.js",
    "watch": "esbuild src/index.tsx --bundle --minify --format=iife --target=safari17 --outfile=../internal/archive/assets/query-tables.js --watch=forever",
    "check-bundle": "esbuild src/index.tsx --bundle --minify --format=iife --target=safari17 --log-level=warning --outfile=node_modules/.cache/check-bundle/query-tables.js && cmp node_modules/.cache/check-bundle/query-tables.js ../internal/archive/assets/query-tables.js && cmp node_modules/.cache/check-bundle/query-tables.css ../internal/archive/assets/query-tables.css && echo 'query-table bundle matches web/src'",
    "generate-schemas": "node generate-schemas.mjs",
    "check-schemas": "node generate-schemas.mjs --check",
    "test:computed-store": "node --test tests/computed-column-store.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pythia-software/query-table-core": "0.6.0",
    "@pythia-software/query-table-react": "0.6.0",
    "@pythia-software/query-table-ui": "0.6.0",
    "@types/markdown-it": "14.1.2",
    "markdown-it": "15.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@pythia-software/query-table-codegen": "0.6.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.27.2",
    "typescript": "5.6.3"
  }
}
