{
  "name": "pharos-query-tables",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "check-bundle": "node build.mjs --check",
    "generate-schemas": "node generate-schemas.mjs",
    "check-schemas": "node generate-schemas.mjs --check",
    "generate-recipes": "node generate-recipe-snapshot.mjs",
    "check-recipes": "node generate-recipe-snapshot.mjs --check",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run check-schemas && npm run check-recipes && npm run check-ask-destinations && npm run check-site-map && npm run build && npm run check-bundle && npm test",
    "test": "node tests/run.mjs unit",
    "test:unit": "node tests/run.mjs unit",
    "test:full": "node tests/run.mjs unit --full",
    "test:browser": "node tests/run.mjs browser",
    "test:e2e": "node tests/run.mjs e2e",
    "test:all": "node tests/run.mjs all",
    "test:usage-aggregations": "node tests/run.mjs unit usage-aggregations",
    "test:computed-store": "node tests/run.mjs unit computed-column-store",
    "test:previews": "node tests/run.mjs unit query-previews",
    "test:text-search": "node tests/run.mjs unit text-search-model",
    "test:search-composer": "node tests/run.mjs unit search-composer",
    "link:local": "node ../tools/link-query-table.mjs",
    "watch:local": "node ../tools/watch-query-table.mjs",
    "generate-ask-destinations": "node generate-ask-destinations.mjs",
    "check-ask-destinations": "node generate-ask-destinations.mjs --check",
    "generate-site-map": "node generate-site-map.mjs",
    "check-site-map": "node generate-site-map.mjs --check"
  },
  "dependencies": {
    "@pythia-software/query-table-core": "0.9.6",
    "@pythia-software/query-table-react": "0.9.6",
    "@pythia-software/query-table-ui": "0.9.6",
    "@types/markdown-it": "14.1.2",
    "html-to-image": "1.11.13",
    "markdown-it": "15.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@pythia-software/query-table-codegen": "0.9.6",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.27.2",
    "playwright-core": "1.64.1",
    "typescript": "5.6.3"
  },
  "allowScripts": {
    "esbuild": false
  }
}
