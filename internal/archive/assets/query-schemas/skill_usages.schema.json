          "expr": "r.\"mcp_server\""
        }
      }
    },
    {
      "name": "mcp_method",
      "label": "Mcp Method",
      "type": "text",
      "group": "Context",
      "filter": {
        "values": {
          "source": "distinct"
        }
      },
      "bindings": {
        "postgres": {
          "expr": "mcp_method",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"mcp_method\""
        }
      }
    },
    {
      "name": "agent_depth",
      "label": "Agent depth",
      "type": "number",
      "group": "Context",
      "render": "number",
      "bindings": {
        "postgres": {
          "expr": "agent_depth",
          "synthetic": true
