          "expr": "r.\"session_kind\""
        }
      }
    },
    {
      "name": "tool_name",
      "label": "Tool Name",
      "type": "text",
      "group": "Context",
      "filter": {
        "values": {
          "source": "distinct"
        }
      },
      "bindings": {
