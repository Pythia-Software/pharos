        "sqlite": {
          "expr": "r.\"agent_depth\"",
          "expressionNumeric": true
        }
      },
      "aggregate": {
        "groupable": true
      }
    },
    {
      "name": "workspace_id",
      "label": "workspace id",
      "type": "text",
      "group": "Evidence",
      "filter": {
        "values": {
          "source": "distinct"
        }
      },
      "bindings": {
        "postgres": {
          "expr": "workspace_id",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"workspace_id\""
        }
      }
    },
    {
      "name": "conversation_id",
      "label": "conversation id",
      "type": "text",
