{
  "$schema": "https://github.com/Pythia-Software/query-table/schema/query-table.schema.json",
  "name": "pharos_skill_usages",
  "version": 1,
  "idField": "id",
  "defaultLimit": 50,
  "defaultSort": [
    {
      "field": "created_at",
      "dir": "desc",
      "nulls": "last"
    }
  ],
  "tiebreakSort": [
    {
      "field": "id",
      "dir": "asc"
    }
  ],
  "defaultSelect": [
    {
      "field": "created_at",
      "width": 150
    },
    {
      "field": "skill_name",
      "width": 190
    },
    {
      "field": "evidence_type",
      "width": 160
    },
    {
      "field": "status",
      "width": 90
    },
    {
      "field": "skill_path",
      "width": 300
    },
    {
      "field": "title",
      "width": 230
    }
  ],
  "fields": [
    {
      "name": "id",
      "label": "Usage ID",
      "type": "text",
      "group": "Skill",
      "filter": {
        "values": {
          "source": "distinct"
        }
      },
      "bindings": {
        "postgres": {
          "expr": "id",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"id\""
        }
      }
    },
    {
      "name": "created_at",
      "label": "Recorded at",
      "type": "datetime",
      "group": "Time",
      "bindings": {
        "postgres": {
          "expr": "created_at",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"created_at\"",
          "datetimeFormat": "utc-millis"
        }
      },
      "aggregate": {
        "groupable": true
      }
    },
    {
      "name": "day",
      "label": "Day",
      "type": "text",
      "group": "Time",
      "filter": {
        "values": {
          "source": "distinct"
        }
      },
      "bindings": {
        "postgres": {
          "expr": "day",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"day\""
        }
      }
    },
    {
      "name": "week",
      "label": "Week",
      "type": "text",
      "group": "Time",
      "filter": {
        "values": {
          "source": "distinct"
        }
      },
      "bindings": {
        "postgres": {
          "expr": "week",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"week\""
        }
      }
    },
    {
      "name": "month",
      "label": "Month",
      "type": "text",
      "group": "Time",
      "filter": {
        "values": {
          "source": "distinct"
        }
      },
      "bindings": {
        "postgres": {
          "expr": "month",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"month\""
        }
      }
    },
    {
      "name": "skill_name",
      "label": "Skill",
      "type": "text",
      "group": "Skill",
      "filter": {
        "values": {
          "source": "distinct"
        }
      },
      "bindings": {
        "postgres": {
          "expr": "skill_name",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"skill_name\""
        }
      }
    },
    {
      "name": "skill_path",
      "label": "Skill path",
      "type": "text",
      "group": "Skill",
      "filter": {
        "values": {
          "source": "distinct"
        }
      },
      "bindings": {
        "postgres": {
          "expr": "skill_path",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"skill_path\""
        }
      }
    },
    {
      "name": "evidence_type",
      "label": "Evidence",
      "type": "enum",
      "group": "Skill",
      "bindings": {
        "postgres": {
          "expr": "evidence_type",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"evidence_type\""
        }
      },
      "filter": {
        "values": {
          "source": "static",
          "options": [
            {
              "value": "explicit_invocation",
              "label": "Explicit invocation"
            },
            {
              "value": "file_load",
              "label": "File-load attempt"
            },
            {
              "value": "harness_load",
              "label": "Harness-reported load"
            }
          ]
        }
      }
    },
    {
      "name": "status",
      "label": "Status",
      "type": "enum",
      "group": "Skill",
      "bindings": {
        "postgres": {
          "expr": "status",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"status\""
        }
      },
      "filter": {
        "values": {
          "source": "static",
          "options": [
            "ok",
            "error",
            "no_result"
          ]
        }
      }
    },
    {
      "name": "content_bytes",
      "label": "Loaded content bytes",
      "type": "number",
      "group": "Skill",
      "render": "number",
      "bindings": {
        "postgres": {
          "expr": "content_bytes",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"content_bytes\"",
          "expressionNumeric": true
        }
      },
      "aggregate": {
        "groupable": true
      }
    },
    {
      "name": "provider",
      "label": "Provider",
      "type": "text",
      "group": "Context",
      "filter": {
        "values": {
          "source": "distinct"
        }
      },
      "bindings": {
        "postgres": {
          "expr": "provider",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"provider\""
        }
      }
    },
    {
      "name": "source_kind",
      "label": "Source Kind",
      "type": "text",
      "group": "Context",
      "filter": {
        "values": {
          "source": "distinct"
        }
      },
      "bindings": {
        "postgres": {
          "expr": "source_kind",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"source_kind\""
        }
      }
    },
    {
      "name": "model",
      "label": "Model",
      "type": "text",
      "group": "Context",
      "filter": {
        "values": {
          "source": "distinct"
        }
      },
      "bindings": {
        "postgres": {
          "expr": "model",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"model\""
        }
      }
    },
    {
      "name": "repository_name",
      "label": "Repository Name",
      "type": "text",
      "group": "Context",
      "filter": {
        "values": {
          "source": "distinct"
        }
      },
      "bindings": {
        "postgres": {
          "expr": "repository_name",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"repository_name\""
        }
      }
    },
    {
      "name": "title",
      "label": "Title",
      "type": "text",
      "group": "Context",
      "filter": {
        "values": {
          "source": "distinct"
        }
      },
      "bindings": {
        "postgres": {
          "expr": "title",
          "synthetic": true
        },
        "sqlite": {
          "expr": "r.\"title\""
        }
      }
    },
    {
      "name": "session_kind",
      "label": "Session Kind",
      "type": "text",
      "group": "Context",
      "filter": {
        "values": {
          "source": "distinct"
        }
      },
      "bindings": {
        "postgres": {
          "expr": "session_kind",
          "synthetic": true
        },
