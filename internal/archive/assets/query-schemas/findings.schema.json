{
  "$schema": "https://github.com/Pythia-Software/query-table/schema/query-table.schema.json",
  "name": "pharos_findings",
  "version": 1,
  "idField": "id",
  "defaultLimit": 50,
  "defaultSort": [{ "field": "likely_ranked", "dir": "desc" }],
  "tiebreakSort": [{ "field": "title", "dir": "asc" }, { "field": "id", "dir": "asc" }],
  "defaultSelect": [
    { "field": "state", "width": 100 },
    { "field": "title", "width": 320 },
    { "field": "detector_label", "width": 150 },
    { "field": "lever_label", "width": 180 },
    { "field": "target_label", "width": 150 },
    { "field": "likely_ranked", "width": 120 },
    { "field": "at_stake_ranked", "width": 120 },
    { "field": "saved_net_usd", "width": 110 },
    { "field": "first_seen_at", "width": 130 }
  ],
  "fields": [
    { "name": "id", "label": "Finding ID", "type": "text", "group": "Finding", "select": {"default": false}, "bindings": {"postgres": {"expr": "id", "synthetic": true}, "sqlite": {"expr": "r.\"id\""}} },
    { "name": "title", "label": "Finding", "type": "text", "group": "Finding", "render": "truncate", "bindings": {"postgres": {"expr": "title", "synthetic": true}, "sqlite": {"expr": "r.\"title\""}} },
    { "name": "detector", "label": "Detector key", "type": "text", "group": "Finding", "select": {"default": false}, "filter": {"values": {"source": "distinct"}}, "bindings": {"postgres": {"expr": "detector", "synthetic": true}, "sqlite": {"expr": "r.\"detector\""}} },
    { "name": "detector_label", "label": "Detector", "type": "text", "group": "Finding", "filter": {"values": {"source": "distinct"}}, "bindings": {"postgres": {"expr": "detector_label", "synthetic": true}, "sqlite": {"expr": "r.\"detector_label\""}} },
    { "name": "state", "label": "State", "type": "enum", "group": "Finding", "description": "Where the finding is in its lifecycle. A regressed win is open again.", "filter": {"editor": "set", "values": {"source": "static", "options": [{"value": "open", "label": "Open"}, {"value": "watching", "label": "Watching"}, {"value": "won", "label": "Won"}, {"value": "dismissed", "label": "Dismissed"}, {"value": "snoozed", "label": "Snoozed"}]}}, "bindings": {"postgres": {"expr": "state", "synthetic": true}, "sqlite": {"expr": "r.\"state\""}} },
    { "name": "is_new", "label": "New", "type": "bool", "group": "Finding", "select": {"default": false}, "description": "Open and new since the Findings view was last opened.", "bindings": {"postgres": {"expr": "is_new", "synthetic": true}, "sqlite": {"expr": "r.\"is_new\""}} },
    { "name": "regressed", "label": "Regressed", "type": "bool", "group": "Finding", "select": {"default": false}, "description": "A verified win came back.", "bindings": {"postgres": {"expr": "regressed", "synthetic": true}, "sqlite": {"expr": "r.\"regressed\""}} },
    { "name": "rate", "label": "Rate", "type": "text", "group": "Finding", "select": {"default": false}, "bindings": {"postgres": {"expr": "rate", "synthetic": true}, "sqlite": {"expr": "r.\"rate\""}} },
    { "name": "lever", "label": "Lever key", "type": "text", "group": "Change", "select": {"default": false}, "filter": {"values": {"source": "distinct"}}, "bindings": {"postgres": {"expr": "lever", "synthetic": true}, "sqlite": {"expr": "r.\"lever\""}} },
    { "name": "lever_label", "label": "Kind of fix", "type": "text", "group": "Change", "description": "Where the suggested change, or the change being measured, is made.", "filter": {"values": {"source": "distinct"}}, "bindings": {"postgres": {"expr": "lever_label", "synthetic": true}, "sqlite": {"expr": "r.\"lever_label\""}} },
    { "name": "change_label", "label": "Change", "type": "text", "group": "Change", "select": {"default": false}, "bindings": {"postgres": {"expr": "change_label", "synthetic": true}, "sqlite": {"expr": "r.\"change_label\""}} },
    { "name": "target_label", "label": "Target", "type": "text", "group": "Change", "filter": {"values": {"source": "distinct"}}, "bindings": {"postgres": {"expr": "target_label", "synthetic": true}, "sqlite": {"expr": "r.\"target_label\""}} },
    { "name": "scope_label", "label": "Scope", "type": "text", "group": "Change", "select": {"default": false}, "filter": {"values": {"source": "distinct"}}, "bindings": {"postgres": {"expr": "scope_label", "synthetic": true}, "sqlite": {"expr": "r.\"scope_label\""}} },
    { "name": "repository_name", "label": "Repository", "type": "text", "group": "Change", "select": {"default": false}, "filter": {"values": {"source": "distinct"}}, "bindings": {"postgres": {"expr": "repository_name", "synthetic": true}, "sqlite": {"expr": "r.\"repository_name\""}} },
    { "name": "first_seen_at", "label": "First seen", "type": "datetime", "group": "Time", "render": "datetime_rel", "bindings": {"postgres": {"expr": "first_seen_at", "synthetic": true}, "sqlite": {"expr": "r.\"first_seen_at\"", "datetimeFormat": "rfc3339"}}, "aggregate": {"groupable": true} },
    { "name": "day", "label": "Day first seen", "type": "text", "group": "Time", "select": {"default": false}, "bindings": {"postgres": {"expr": "day", "synthetic": true}, "sqlite": {"expr": "r.\"day\""}} },
    { "name": "rank_unit", "label": "Rank unit", "type": "enum", "group": "Savings", "select": {"default": false}, "description": "The Findings rank setting; the same on every row. The ranked columns are in this unit.", "filter": {"editor": "set", "values": {"source": "static", "options": [{"value": "usd", "label": "Cost (USD)"}, {"value": "tokens", "label": "Tokens"}, {"value": "minutes", "label": "Minutes"}, {"value": "failures", "label": "Failures"}]}}, "bindings": {"postgres": {"expr": "rank_unit", "synthetic": true}, "sqlite": {"expr": "r.\"rank_unit\""}} },
    { "name": "likely_ranked", "label": "Likely saving / month", "type": "number", "group": "Savings", "render": "number", "select": {"align": "right"}, "description": "Likely monthly saving in the rank unit: what the pattern cost × the share a change can remove × how often a change takes × how often the pattern persists untreated.", "bindings": {"postgres": {"expr": "likely_ranked", "synthetic": true}, "sqlite": {"expr": "r.\"likely_ranked\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "likely_usd", "label": "Likely saving / month (USD)", "type": "number", "group": "Savings", "render": "usd", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "likely_usd", "synthetic": true}, "sqlite": {"expr": "r.\"likely_usd\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "likely_tokens", "label": "Likely saving / month (tokens)", "type": "number", "group": "Savings", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "likely_tokens", "synthetic": true}, "sqlite": {"expr": "r.\"likely_tokens\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "likely_minutes", "label": "Likely saving / month (minutes)", "type": "number", "group": "Savings", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "likely_minutes", "synthetic": true}, "sqlite": {"expr": "r.\"likely_minutes\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "likely_failures", "label": "Likely saving / month (failures)", "type": "number", "group": "Savings", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "likely_failures", "synthetic": true}, "sqlite": {"expr": "r.\"likely_failures\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "at_stake_ranked", "label": "At stake / month", "type": "number", "group": "At stake", "render": "number", "select": {"align": "right"}, "description": "What the pattern cost over the last 28 days, in the rank unit.", "bindings": {"postgres": {"expr": "at_stake_ranked", "synthetic": true}, "sqlite": {"expr": "r.\"at_stake_ranked\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "at_stake_usd", "label": "At stake (USD)", "type": "number", "group": "At stake", "render": "usd", "select": {"default": false, "align": "right"}, "description": "What the pattern cost over the last 28 days.", "bindings": {"postgres": {"expr": "at_stake_usd", "synthetic": true}, "sqlite": {"expr": "r.\"at_stake_usd\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "at_stake_tokens", "label": "At stake (tokens)", "type": "number", "group": "At stake", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "at_stake_tokens", "synthetic": true}, "sqlite": {"expr": "r.\"at_stake_tokens\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "at_stake_minutes", "label": "At stake (minutes)", "type": "number", "group": "At stake", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "at_stake_minutes", "synthetic": true}, "sqlite": {"expr": "r.\"at_stake_minutes\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "at_stake_failures", "label": "At stake (failures)", "type": "number", "group": "At stake", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "at_stake_failures", "synthetic": true}, "sqlite": {"expr": "r.\"at_stake_failures\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "saved_net_usd", "label": "Saved, net (USD)", "type": "number", "group": "Results", "render": "usd", "select": {"align": "right"}, "description": "Verified savings minus the added context cost, across the finding's improved results, regressed ones included.", "bindings": {"postgres": {"expr": "saved_net_usd", "synthetic": true}, "sqlite": {"expr": "r.\"saved_net_usd\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "saved_usd", "label": "Saved (USD)", "type": "number", "group": "Results", "render": "usd", "select": {"default": false, "align": "right"}, "description": "Verified savings before the added context cost.", "bindings": {"postgres": {"expr": "saved_usd", "synthetic": true}, "sqlite": {"expr": "r.\"saved_usd\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "saved_added_usd", "label": "Added context cost (USD)", "type": "number", "group": "Results", "render": "usd", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "saved_added_usd", "synthetic": true}, "sqlite": {"expr": "r.\"saved_added_usd\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "saved_tokens", "label": "Saved (tokens)", "type": "number", "group": "Results", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "saved_tokens", "synthetic": true}, "sqlite": {"expr": "r.\"saved_tokens\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "saved_added_tokens", "label": "Added context (tokens)", "type": "number", "group": "Results", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "saved_added_tokens", "synthetic": true}, "sqlite": {"expr": "r.\"saved_added_tokens\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "saved_minutes", "label": "Saved (minutes)", "type": "number", "group": "Results", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "saved_minutes", "synthetic": true}, "sqlite": {"expr": "r.\"saved_minutes\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "saved_failures", "label": "Saved (failures)", "type": "number", "group": "Results", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "saved_failures", "synthetic": true}, "sqlite": {"expr": "r.\"saved_failures\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "saved_weeks", "label": "Weeks measured", "type": "number", "group": "Results", "render": "number", "select": {"default": false, "align": "right"}, "description": "The longest run of measured weeks among the finding's results; combine with MAX, not SUM.", "bindings": {"postgres": {"expr": "saved_weeks", "synthetic": true}, "sqlite": {"expr": "r.\"saved_weeks\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "wins", "label": "Verified wins", "type": "number", "group": "Results", "render": "number", "select": {"default": false, "align": "right"}, "description": "Improved results, regressed ones included.", "bindings": {"postgres": {"expr": "wins", "synthetic": true}, "sqlite": {"expr": "r.\"wins\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} },
    { "name": "finding_count", "label": "Findings", "type": "number", "group": "Metrics", "render": "number", "select": {"default": false, "align": "right"}, "bindings": {"postgres": {"expr": "finding_count", "synthetic": true}, "sqlite": {"expr": "r.\"finding_count\"", "expressionNumeric": true}}, "aggregate": {"groupable": true} }
  ]
}
