{
  "contract": "pharos-push-config/1",
  "access": "write",
  "prefix": "pharos/{owner}",
  "retention_days": 90,
  "destination": {
    "type": "s3",
    "bucket": "example-pharos-transcripts",
    "region": "us-east-1",
    "role_arn": "arn:aws:iam::123456789012:role/pharos-push",
    "identity_token": {
      "command": [
        "ns",
        "oidc-token",
        "--audience",
        "sts.amazonaws.com"
      ]
    }
  }
}