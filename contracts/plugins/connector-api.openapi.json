{
  "openapi": "3.1.0",
  "info": {
    "title": "Pharos connector API",
    "version": "1",
    "description": "Served by Pharos on loopback for the length of a plugin run. Every request carries the run's bearer token, which identifies the plugin, run and consented permissions; no other credential works here. Every answer is as of the run's cutoff (the library's export delay before the run started). Requests never write to the library: what a run read is counted in memory and recorded when the run ends. Requests are handled one at a time per run; near a limit Pharos answers 429 with Retry-After, and past it revokes the token. Private work items and usage are never returned, counted or aggregated. Checks run in a fixed order: token, then grant (dataset, fields, mode, group keys, text, export), then existence; so a 404 never distinguishes a private item from an absent one, and a 403 never depends on whether an item exists."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}/connector/v1",
      "variables": {
        "port": {
          "default": "53817"
        }
      }
    }
  ],
  "security": [
    {
      "runToken": []
    }
  ],
  "paths": {
    "/grant": {
      "get": {
        "operationId": "getGrant",
        "summary": "What this run may do, and how much of its limits it has used",
        "responses": {
          "200": {
            "description": "The grant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "connector.schema.json#/$defs/grant"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/credential": {
      "get": {
        "operationId": "getCredential",
        "summary": "A short-lived access token for the plugin's receiver",
        "responses": {
          "200": {
            "description": "The credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "connector.schema.json#/$defs/credential"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/query/{dataset}": {
      "post": {
        "operationId": "query",
        "summary": "Run an export query over one granted dataset",
        "description": "Every field the query names must be granted; group keys and periods must be ones the dataset allows (see /grant). Forced filters and redaction apply; filters on a redacted field compare redacted values.",
        "parameters": [
          {
            "$ref": "#/components/parameters/Dataset"
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "export-query.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rows or groups",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "connector.schema.json#/$defs/query_result"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/NotGranted"
          },
          "429": {
            "$ref": "#/components/responses/Limit"
          }
        }
      }
    },
    "/items/{dataset}": {
      "get": {
        "operationId": "getItems",
        "summary": "Rows of one granted dataset by opaque ID, for example those listed by /changes",
        "parameters": [
          {
            "$ref": "#/components/parameters/Dataset"
          },
          {
            "name": "ids",
            "in": "query",
            "required": true,
            "description": "Comma-separated opaque IDs of this dataset.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The rows that exist and are exportable; others are simply absent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "connector.schema.json#/$defs/items_page"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/NotGranted"
          },
          "429": {
            "$ref": "#/components/responses/Limit"
          }
        }
      }
    },
    "/changes": {
      "get": {
        "operationId": "getChanges",
        "summary": "What to send again, restate or retract since a change token",
        "description": "Changes in the granted datasets after since, up to the run's as_of. Without since, everything readable is a change. Retractions are those queued for this plugin: items it was served that are no longer exportable. A token older than the feed's retention (30 days) gets 410 cursor_expired: start again without since, which sends everything.",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "schema": {
              "$ref": "common.schema.json#/$defs/change_token"
            }
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of changes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "connector.schema.json#/$defs/changes"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "429": {
            "$ref": "#/components/responses/Limit"
          },
          "410": {
            "description": "cursor_expired: the token is older than the feed keeps",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "common.schema.json#/$defs/error"
                }
              }
            }
          }
        }
      }
    },
    "/conversations/{id}/messages": {
      "get": {
        "operationId": "listMessages",
        "summary": "A conversations/1 item's messages up to as_of, when the grant allows text",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "common.schema.json#/$defs/opaque_id"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/Limit"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of messages",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "connector.schema.json#/$defs/messages_page"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/NotGranted"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/Limit"
          }
        },
        "description": "Needs text and conversations/1 in the grant. Without them the answer is 403 whatever the ID; with them, an absent or private conversation is 404."
      }
    },
    "/export": {
      "get": {
        "operationId": "exportBundle",
        "summary": "A pharos-drop/1 bundle of transcripts, for another Pharos",
        "description": "A tar stream with bundle.json first, then the drops' files. Needs export_bundles. Only conversations captured by this library's own Macs, unless forward_imported. Sized to stay within the run's served bytes; Pharos-Next-Cursor and Pharos-More headers page through the rest.",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "schema": {
              "$ref": "common.schema.json#/$defs/change_token"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "max_bytes",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A bundle",
            "headers": {
              "Pharos-Next-Cursor": {
                "schema": {
                  "type": "string"
                }
              },
              "Pharos-More": {
                "schema": {
                  "enum": [
                    "true",
                    "false"
                  ]
                }
              }
            },
            "content": {
              "application/x-tar": {
                "schema": {
                  "type": "string",
                  "contentMediaType": "application/x-tar"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/NotGranted"
          },
          "429": {
            "$ref": "#/components/responses/Limit"
          }
        }
      }
    },
    "/resend": {
      "post": {
        "operationId": "recordResend",
        "summary": "Record that a scripted exporter's receiver asked for everything",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "connector.schema.json#/$defs/resend_request"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Recorded; acknowledged state for this plugin is reset when the run is acknowledged"
          },
          "400": {
            "$ref": "#/components/responses/Invalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "runToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "request.api.token, also in PHAROS_TOKEN. Valid until the run ends."
      }
    },
    "parameters": {
      "Dataset": {
        "name": "dataset",
        "in": "path",
        "required": true,
        "description": "Export dataset with version, URL-encoded: usage%2F1.",
        "schema": {
          "$ref": "common.schema.json#/$defs/dataset"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "description": "Page size, capped by Pharos.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing, unknown or expired token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "common.schema.json#/$defs/error"
            }
          }
        }
      },
      "NotGranted": {
        "description": "A dataset, field, mode, group key, text or export outside the grant; names what was refused. Decided before existence is looked up.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "common.schema.json#/$defs/error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Unknown or not readable; private items are indistinguishable from absent ones",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "common.schema.json#/$defs/error"
            }
          }
        }
      },
      "Invalid": {
        "description": "Malformed request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "common.schema.json#/$defs/error"
            }
          }
        }
      },
      "Limit": {
        "description": "Near a limit; retry after the given time. Past it the token is revoked and the run stops.",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "common.schema.json#/$defs/error"
            }
          }
        }
      }
    }
  }
}
