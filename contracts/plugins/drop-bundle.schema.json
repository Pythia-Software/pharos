{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharos.pythia.software/contracts/plugins/drop-bundle.schema.json",
  "title": "Drop bundle (pharos-drop/1)",
  "description": "bundle.json at the root of a bundle that one library exports (GET /connector/v1/export) and another imports. The bundle's folders are drops in the same layout as an importer's output_dir, so an importer can copy them into its output_dir and declare them unchanged. Private conversations are already absent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "generated_at", "machines", "drops", "files"],
  "properties": {
    "contract": {"const": "pharos-drop/1"},
    "generated_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "sender_id": {"$ref": "common.schema.json#/$defs/sender_id"},
    "machines": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/machine"}
    },
    "drops": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/drop"}
    },
    "files": {
      "description": "Every file in the bundle except bundle.json, so the importer can verify it before declaring the drops.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256", "mtime"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 0},
          "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "mtime": {"$ref": "common.schema.json#/$defs/timestamp"}
        }
      }
    }
  }
}
