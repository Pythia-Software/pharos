+// SURVEY PROTOTYPE: initialize one catalog per process, then copy it per test.
+var catalogTemplate struct {
+	once  sync.Once
+	bytes []byte
+	err   error
+}
+
+func openTemplateCatalog(path string) (*Catalog, error) {
+	catalogTemplate.once.Do(func() {
+		dir, err := os.MkdirTemp("", "pharos-catalog-template-")
+		if err != nil {
+			catalogTemplate.err = err
+			return
+		}
+		defer os.RemoveAll(dir)
+		template := filepath.Join(dir, "catalog.sqlite3")
+		// Host-neutral: register no host in the template; each open does.
+		previous := currentHost
+		currentHost = func() Host { return Host{ID: "template", Fallback: true} }
+		c, err := OpenCatalog(template)
+		currentHost = previous
+		if err != nil {
+			catalogTemplate.err = err
+			return
+		}
+		c.Close()
+		catalogTemplate.bytes, catalogTemplate.err = os.ReadFile(template)
+	})
+	if catalogTemplate.err != nil {
+		return nil, catalogTemplate.err
+	}
+	if err := os.WriteFile(path, catalogTemplate.bytes, 0o600); err != nil {
+		return nil, err
+	}
+	db, err := sql.Open("sqlite", catalogDSN(path))
+	if err != nil {
+		return nil, err
+	}
+	db.SetMaxOpenConns(4)
+	db.SetMaxIdleConns(4)
+	catalog := &Catalog{Path: path, DB: db, captureRoot: filepath.Join(filepath.Dir(path), "captures")}
+	if err := catalog.migrateHosts(); err != nil {
+		db.Close()
+		return nil, err
+	}
+	if err := catalog.openReader(); err != nil {
+		db.Close()
+		return nil, err
+	}
+	return catalog, nil
+}
+
